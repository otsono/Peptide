// Character stats-codegen data tables (moved out of Rust so they can change
// without a rebuild). Consumed by haxe_gen's HitboxStats.hx / CharacterStats.hx
// generators. The Haxe scaffolding around these lives in character_helpers.toml.
{
  // HitboxStats.hx move grouping: section header → ordered FM move names.
  "hitbox_sections": [
    { "section": "LIGHT ATTACKS",   "moves": ["jab1","jab2","jab3","dash_attack","tilt_forward","tilt_up","tilt_down"] },
    { "section": "STRONG ATTACKS",  "moves": ["strong_forward_attack","strong_up_attack","strong_down_attack"] },
    { "section": "AERIAL ATTACKS",  "moves": ["aerial_neutral","aerial_forward","aerial_back","aerial_up","aerial_down"] },
    { "section": "SPECIAL ATTACKS", "moves": ["special_neutral","special_neutral_air","special_side","special_side_air","special_up","special_up_air","special_down","special_down_air"] },
    { "section": "THROWS",          "moves": ["throw_up","throw_down","throw_forward","throw_back"] },
    { "section": "MISC ATTACKS",    "moves": ["ledge_attack","crash_attack","emote"] }
  ],

  // CharacterStats.hx field groups. The engine MERGES a character's stats over its own defaults
  // (Util.setDefaults), so a field emitted here is not a default -- it OVERRIDES the engine's,
  // and when the value came from a stock character's file it overrides it with somebody else's.
  // So a group lists only what the SOURCE states; the rest is left out and the engine answers.
  // Values still come from stats.jsonc `constants`; `anno` (ECB only) is an inline comment.
  "stats_fields": {
    // the body the source states, and nothing else: the hip offsets and how far the body hangs
    // below the origin in the air are the engine's to answer
    "ecb": [
      { "field": "floorHeadPosition",  "anno": "" },
      { "field": "floorHipWidth",      "anno": "" },
      { "field": "aerialHeadPosition", "anno": "" },
      { "field": "aerialHipWidth",     "anno": "" }
    ],
    // the camera box and the shield are not stated by the source at all
    "camera": [],
    // the source states how fast a roll travels, never for how long, and never the ledge jump.
    // its dodge roll moves from its first frame (falco's 16 there on frame 1), where this engine's
    // waits for its own start frame (3 unless stated): the start is written as 1 (stats.jsonc; 0
    // never starts it), which still moves a frame after the source's, and the length left one frame
    "roll": ["techRollSpeed","dodgeRollSpeed","dodgeRollSpeedStartFrame","getupRollSpeed","ledgeRollSpeed"],
    // the source has no air dash: its air dodge leaves the fighter where it is, keeping its
    // momentum (measured). this engine's airdash blinks a fighter across the stage in one frame
    // (measured on a stock fighter too), so it is switched off and the fighter plays its own
    // air-dodge clip instead
    "airdash": ["airdashLimit"],
    "shield": [],
    // the voice LISTS are the character's own content; how often a voice is skipped is not stated
    // by the source and is the engine's to answer
    "voice": [
      "attackVoiceIds","hurtLightVoiceIds","hurtMediumVoiceIds","hurtHeavyVoiceIds","koVoiceIds"
    ]
  },

  // guess_limb: first rule whose `contains` matches the move name (substring)
  // wins; `default` if none. Order matters.
  "limb_rules": {
    "default": "AttackLimb.FIST",
    "rules": [
      { "contains": ["throw"],              "limb": "AttackLimb.BODY" },
      { "contains": ["down"],               "limb": "AttackLimb.FOOT" },
      { "contains": ["aerial"],             "limb": "AttackLimb.FOOT" },
      { "contains": ["tilt_up","strong_up"],"limb": "AttackLimb.FIST" },
      { "contains": ["neutral"],            "limb": "AttackLimb.FOOT" },
      { "contains": ["jab"],                "limb": "AttackLimb.FIST" },
      { "contains": ["tilt","forward"],     "limb": "AttackLimb.FIST" },
      { "contains": ["special"],            "limb": "AttackLimb.FIST" },
      { "contains": ["ledge","crash"],      "limb": "AttackLimb.FOOT" }
    ]
  }
}

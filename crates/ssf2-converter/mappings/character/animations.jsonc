// ─────────────────────────────────────────────────────────────────────────
// animations.jsonc — SSF2 → Fraymakers animation name mappings (CHARACTER)
//
// Loaded at runtime; built-in defaults are used if this file is missing or
// malformed. Edit freely — no recompile needed. JSONC: // comments and
// trailing commas are allowed.
//
//  ssf2_to_fm    — maps an SSF2 xframe/animation name to a Fraymakers slot.
// ─────────────────────────────────────────────────────────────────────────
{
  "ssf2_to_fm": {
    "stand": "stand",
    "walk": "walk",
    "run": "run",
    "jump": "jump",
    "jump_midair": "jump_midair",
    "fall": "fall",
    "land": "land",
    "heavyland": "land_heavy",
    "skid": "skid",
    "crouch": "crouch",
    "entrance": "intro",
    "revival": "revival",
    "win": "victory",
    "lose": "defeat",

    "a": "jab",
    "a_forward": "dash_attack",
    "a_forward_tilt": "tilt_forward",
    "a_up_tilt": "tilt_up",
    // a_down is the down SMASH state (DownSmash_ sprite) → strong_down (split into
    // _in/_charge/_attack by the strong arm). The down TILT lives in crouch_attack
    // (DownTilt_ sprite) → tilt_down.
    "a_down": "strong_down",
    "crouch_attack": "tilt_down",
    "a_forwardsmash": "strong_forward",
    "a_up": "strong_up",
    "a_air": "aerial_neutral",
    "a_air_forward": "aerial_forward",
    "a_air_backward": "aerial_back",
    "a_air_up": "aerial_up",
    "a_air_down": "aerial_down",
    "b": "special_neutral",
    "b_air": "special_neutral_air",
    "b_forward": "special_side",
    "b_forward_air": "special_side_air",
    "b_up": "special_up",
    "b_up_air": "special_up_air",
    "b_down": "special_down",
    "b_down_air": "special_down_air",
    "throw_forward": "throw_forward",
    "throw_back": "throw_back",
    "throw_up": "throw_up",
    "throw_down": "throw_down",
    "ledge_attack": "ledge_attack",
    "getup_attack": "getup_attack",

    "defend": "shield",
    "dodgeroll": "roll",
    "roll": "crash_roll",
    "airdodge": "airdodge",
    "sidestep": "spot_dodge",
    "grab": "grab",
    "carry": "carry",

    "hurt": "hurt",
    "stunned": "stunned",
    "dizzy": "dizzy",
    "sleep": "sleep",
    "tumble": "tumble",
    // SSF2's launch sequence is TWO xframes: "flying" (the somersault shown during
    // heavy hitstun) -> hurt_heavy, then "falling" (the drifting tumble that follows)
    // -> tumble. NEVER route "falling" to "fall": that pulled fall's hurtboxes from
    // "falling" while the sprite came from "fall", landing the boxes ~35px off the body.
    "falling": "tumble",
    "crash": "crash_bounce",
    "frozen": "frozen",
    "egg": "egg",
    "star": "star_ko",
    "pitfall": "buried",

    "hang": "ledge_hang",
    "climbup": "ledge_climb",
    "edgelean": "ledge_lean",
    "rollup": "ledge_roll",
    "wallstick": "wall_stick",

    "taunt": "taunt",
    "swim": "swim",
    "ladder": "ladder",
    "flying": "hurt_heavy",
    "special": "special",
    "tech_ground": "tech",
    "tech_roll": "tech_roll",
    "toss": "item_throw",
    "toss_air": "item_throw_air",

    "item_pickup": "item_pickup",
    "item_jab": "item_jab",
    "item_dash": "item_dash_attack",
    "item_tilt": "item_tilt",
    "item_smash": "item_smash",
    "item_homerun": "item_homerun",
    "item_fan": "item_fan",
    "item_shoot": "item_shoot",
    "item_raise": "item_raise",
    "item_float": "item_float",
    "item_screw": "item_screw",
    "item_heavyshoot": "item_heavyshoot",
    "item_firedash": "item_firedash",
    "item_bubblebounce": "item_bubblebounce",
  },
}

// Every method the PUBLISHED Fraymakers scripting api declares, taken from the api-types
// plugin that ships with FrayTools. Nothing here is read out of the engine: it is the surface
// the engine documents for scripts, the same surface commands.jsonc already maps onto.
//
// What it is FOR: a call this engine cannot answer does not fail quietly, it takes the whole
// handler down with it, and the rest of that move never runs. Knowing the surface means the
// converter can say so while converting instead of leaving it to be found one character at a
// time by playing them.
{
  // What a GAME OBJECT answers to, which is less than a character does. A foe held in a grab
  // is one of these, so asking it what buttons are held is asking something it has no way to
  // know -- and the ask is refused rather than answered, taking the move with it.
  // Not the engine's at all: what an array, a string, a number or one of this converter's own
  // state wrappers answers to. A call on a wrapper READ is only unanswerable if nobody at all
  // has the name -- an array being told to push is not the engine being asked anything.
  "standard_methods": [
    "abs",
    "atan2",
    "getAngleBetween",
    "ceil",
    "charAt",
    "charCodeAt",
    "concat",
    "contains",
    "copy",
    "cos",
    "dec",
    "floor",
    "fromCharCode",
    "get",
    "getBool",
    "getFloat",
    "getInt",
    "getValue",
    "inc",
    "indexOf",
    "int",
    "isNaN",
    "iterator",
    "join",
    "lastIndexOf",
    "log",
    "max",
    "min",
    "parseFloat",
    "parseInt",
    "play",
    "pop",
    "pow",
    "push",
    "random",
    "remove",
    "resolve",
    "reverse",
    "round",
    "set",
    "setValue",
    "shift",
    "sin",
    "slice",
    "sort",
    "splice",
    "split",
    "sqrt",
    "string",
    "substr",
    "substring",
    "tan",
    "toLowerCase",
    "toString",
    "toUpperCase",
    "trim",
    "unshift"
  ],

  // What the MATCH itself answers to. A call the match has no name for does not fall through
  // to whatever else has that name -- it is a null, and it takes the handler down. Knowing this
  // surface is how a call put on the match that belongs to an object gets sent to the object.
  "match_methods": [
    "addEventListener",
    "addTimer",
    "checkFirstBlood",
    "checkTwoPlayersLastLife",
    "createCustomApiObject",
    "createCustomGameObject",
    "createLineSegmentStructure",
    "createProjectile",
    "createRibbonTrail",
    "createShockwaveEffect",
    "createSpriteStructure",
    "createStructure",
    "createVfx",
    "freezeScreen",
    "getCamera",
    "getCharacters",
    "getCollisionAreaByName",
    "getCollisionAreas",
    "getCustomGameObjects",
    "getElapsedFrames",
    "getMatchSettingsConfig",
    "getPlayers",
    "getProjectiles",
    "getStructureByName",
    "getStructures",
    "getTimeLeft",
    "hasEventListener",
    "hasModifier",
    "isDisposed",
    "isReplay",
    "makeArray",
    "makeBool",
    "makeEaseTimer",
    "makeFloat",
    "makeFrameTimer",
    "makeInt",
    "makeObject",
    "makePoint",
    "makeString",
    "removeEventListener",
    "removeTimer",
    "spawnKOBlast"
  ],


// the source's events this engine raises itself, settled at conversion: a listener the source's
// code adds for one is this engine's own listener for the event here, on the object's engine
// handle. an event with no row is raised by the runtime where the source's engine would (the end
// of an attack, a projectile's end), or by nothing.
{
  "engine": {
    "groundTouch":          "EntityEvent.COLLIDE_FLOOR",
    "charLand":             "EntityEvent.COLLIDE_FLOOR",
    "hitWall":              "EntityEvent.COLLIDE_WALL",
    "groundLeave":          "GameObjectEvent.LEFT_GROUND",
    "attackHit":            "GameObjectEvent.HIT_DEALT",
    "attackConnect":        "GameObjectEvent.HIT_DEALT",
    "attackHitShield":      "GameObjectEvent.SHIELD_HIT_DEALT",
    "attackHitPowerShield": "GameObjectEvent.SHIELD_HIT_DEALT",
    "attackConnectShield":  "GameObjectEvent.SHIELD_HIT_DEALT",
    "charHurt":             "GameObjectEvent.HIT_RECEIVED",
    "projHurt":             "GameObjectEvent.HIT_RECEIVED",
    "itemHurt":             "GameObjectEvent.HIT_RECEIVED",
    "enemyHurt":            "GameObjectEvent.HIT_RECEIVED",
    "charShieldHit":        "GameObjectEvent.SHIELD_HIT_RECEIVED",
    "charPowerShieldHit":   "GameObjectEvent.SHIELD_HIT_RECEIVED",
    "charGrab":             "GameObjectEvent.GRAB_DEALT",
    "charGrabbed":          "GameObjectEvent.GRAB_RECEIVED",
    "charLedgeGrab":        "CharacterEvent.LEDGE_GRAB",
    "charKODeath":          "CharacterEvent.KNOCK_OUT",
    "charCounter":          "GameObjectEvent.COUNTER",
    "charAbsorb":           "GameObjectEvent.ABSORBBOX_CONNECTED",
    "reverseHit":           "GameObjectEvent.REFLECTBOX_CONNECTED",
    "reverse":              "GameObjectEvent.REFLECTED"
  },
  // the events an item's handler raises itself (`runtime/native/item.hx`): its own listeners for
  // them, the list the handler tells
  "item": {
    "itemPickup": "pickupListeners",
    "itemTossed": "tossListeners"
  },
  // the fields of the record an item's handler hands its frame interrupt (its holder's attack put
  // to it first), read as they are, and what each is
  "interrupt": { "targetFrame": "string", "character": "object", "cStick": "bool", "zair": "bool" },
  // a change of state: the engine's event, told to the source's listeners with the source's own
  // states either side (the runtime keeps them)
  "state": { "stateChange": "EntityEvent.STATE_CHANGE" },
  // the engine's events a listener added without `persistent` hears: raised while the animation it
  // was added in still plays. the engine drops such a listener as the animation (or the state)
  // changes, so a clip one animation shows listens for these that way and its listener goes with it,
  // as the source's goes with its clip. an event raised as the state changes (its own change, a hit
  // taken) never reaches one, so a listener for any event not listed here stays until the fighter
  // leaves the clip. measured live, one at a time
  "heard_in_animation": ["EntityEvent.COLLIDE_FLOOR"],
  // the fields of the record the source's engine hands a listener, as this engine's event has them
  // (`{arg}` is the event). `is` says what the value is: a test passes here only on a literal true
  "record": {
    // whoever was hit, or hit it, is the event's foe; the one listening is the object itself
    "receiver":  { "code": "{arg}.data.foe", "is": "object" },
    "opponent":  { "code": "{arg}.data.foe", "is": "object" },
    "grabbed":   { "code": "{arg}.data.foe", "is": "object" },
    "grabber":   { "code": "{arg}.data.foe", "is": "object" },
    "projectile": { "code": "{arg}.data.foe", "is": "object" },
    "caller":    { "code": "self", "is": "object" },
    // the side of the object a wall it met is on: a wall to its left is a structure's right side.
    // `top` is a ceiling, which this engine tells of with its own event, so a wall's is never one
    "left":      { "code": "{arg}.data.structureType == StructureType.RIGHT_WALL", "is": "bool" },
    "right":     { "code": "{arg}.data.structureType == StructureType.LEFT_WALL", "is": "bool" },
    "top":       { "code": "{arg}.data.structureType == StructureType.CEILING", "is": "bool" }
  },
  // the other fields the source's engine puts in a record it hands a listener, which nothing above
  // translates yet. a field in neither list is in no record of the source's: reading it gives
  // nothing there, and so it does here
  "unrecorded": ["attackBoxData", "attackData", "auto", "callerAttackBoxData", "damage", "fromState", "holder",
    "isMetal", "receiverAttackBoxData", "sizeStatus", "target", "toState", "type", "victim"]
}

// what a projectile's declared stats have it do as it flies, settled at conversion. the source's
// engine moves a projectile by these stats every frame; here each one it states writes its
// variables and a function into the projectile's script, and its update calls that function every
// engine frame it flies (not while it is frozen by a hit, nor while it plays its end), through
// one `flyByStats()` that calls each row's `call` in order
//
// each row, by the stat that takes it:
//   when       `positive`, `negative`, `nonnegative`, `true` or `false`: the value it holds for;
//              `effect`: it names an effect the object can make
//   yields_to  another row that, taken too, does this one's work as well
//   same_as    another row whose code this one writes (one function serving both stats)
//   reads      the other stats its code reads
//   replaces   the runtime's piece it stands in for
//   code       the lines it writes into the script, once: `{v}` the stat's value, `{name}` another
//              stat the projectile states (0 when none, `{name|d}` d), `{@speed}` `{@accel}`
//              `{@size}` the source's units in this engine's, `{@effect}` the effect's stats
//   call       what its update runs each frame
// a row is not taken when the projectile's own code changes a stat it reads as it flies, or
// another declaration that shares its clip states one otherwise: the runtime's piece runs then.
// rows run in the order written here, from `frame`: the function the update calls, `{calls}` each
// taken row's `call`
{
  "frame": [
    "// what its declared stats have it do each engine frame it flies",
    "function flyByStats() {",
    "\t{calls}",
    "}"
  ],
  "code": {
    "homingSpeed": { "when": "nonnegative", "reads": ["xdecay", "homingEase"], "replaces": "Projectiles.steer", "call": "homeIn();",
      "code": [
        "// homing: the heading turns toward the middle of the nearest opponent that can be hit, a share",
        "// of the turn each source frame (`homingEase`, half as much an engine frame), keeping its own",
        "// speed less its slowdown (samus's missile, launched at 10 with 0.15, slows by 0.15 a source",
        "// frame while it turns). it flies its first frame straight",
        "var homingSlowdown = {xdecay|0} * {@speed} * 0.5;",
        "var homingEase = Math.max(1, {homingEase|1}) * 2;",
        "var homingHeading = null;",
        "var homingFrames = 0;",
        "function homeIn() {",
        "\thomingFrames++;",
        "\tif (homingFrames < 2) {",
        "\t\tif (homingSlowdown != 0) self.setXSpeed(self.getXSpeed() - homingSlowdown);",
        "\t\treturn;",
        "\t}",
        "\tvar speed = Math.max(0, Math.sqrt(self.getXSpeed() * self.getXSpeed() + self.getYSpeed() * self.getYSpeed()) - homingSlowdown);",
        "\tvar target = null;",
        "\tvar nearest = 1.0e12;",
        "\tfor (c in match.getCharacters()) {",
        "\t\tif (c == self.getOwner() || c.isDisposed() || c.hasBodyStatus(BodyStatus.INTANGIBLE) || c.hasBodyStatus(BodyStatus.INVINCIBLE)) continue;",
        "\t\tvar dx = c.getX() - self.getX();",
        "\t\tvar dy = c.getY() - self.getY();",
        "\t\tif (dx * dx + dy * dy < nearest) {",
        "\t\t\tnearest = dx * dx + dy * dy;",
        "\t\t\ttarget = c;",
        "\t\t}",
        "\t}",
        "\tif (target == null) return;",
        "\tvar middle = target.getY() - target.getCharacterStat(target.isOnFloor() ? \"floorHeadPosition\" : \"aerialHeadPosition\") / 2;",
        "\tvar want = Math.atan2(middle - self.getY(), target.getX() - self.getX());",
        "\tif (homingHeading == null) homingHeading = Math.atan2(self.getYSpeed(), self.flipX(self.getXSpeed()));",
        "\tvar turn = want - homingHeading;",
        "\twhile (turn > Math.PI) turn -= 2 * Math.PI;",
        "\twhile (turn < -Math.PI) turn += 2 * Math.PI;",
        "\thomingHeading += turn / homingEase;",
        "\tself.setXSpeed(self.flipX(Math.cos(homingHeading) * speed));",
        "\tself.setYSpeed(Math.sin(homingHeading) * speed);",
        "}"
      ] },
    "xdecay": { "when": "true", "yields_to": "homingSpeed", "reads": ["homingSpeed"], "replaces": "Projectiles.steer", "call": "slowDown();",
      "code": [
        "// its x slowdown: a steady push back against the way it faces, each source frame. it stops at",
        "// nothing when it slows a shot going forward; a negative one speeds it up (zelda's din's fire),",
        "// and one going backward keeps on speeding back (link's boomerang on its way home)",
        "var slowdown = {v} * {@speed} * 0.5;",
        "function slowDown() {",
        "\tvar speed = self.getXSpeed();",
        "\tvar slowed = speed - slowdown;",
        "\tself.setXSpeed(slowdown > 0 && speed >= 0 && slowed < 0 ? 0 : slowed);",
        "}"
      ] },
    "influenceXMovement": { "when": "positive", "reads": ["influenceYMovement", "influenceXFactor", "influenceYFactor"], "replaces": "Projectiles.influence", "call": "followStick();",
      "code": [
        "// the owner's held stick nudges it, per axis: stepped toward the held way by the axis' factor",
        "// each engine frame, back toward nothing when the stick is let go, kept within its movement,",
        "// and added to where it is on top of its own flight",
        "var stickReachX = {influenceXMovement|0} * {@speed};",
        "var stickReachY = {influenceYMovement|0} * {@speed};",
        "var stickStepX = {influenceXFactor|0} * {@speed};",
        "var stickStepY = {influenceYFactor|0} * {@speed};",
        "var stickX = 0.0;",
        "var stickY = 0.0;",
        "function nudge(v, step, reach, plus, minus) {",
        "\tif (plus) v += step;",
        "\telse if (minus) v -= step;",
        "\telse if (v > 0) v = Math.max(0, v - step);",
        "\telse if (v < 0) v = Math.min(0, v + step);",
        "\treturn Math.max(-reach, Math.min(reach, v));",
        "}",
        "function followStick() {",
        "\tvar owner = self.getOwner();",
        "\tif (owner == null || owner.getHeldControls == null) return;",
        "\tvar held = owner.getHeldControls();",
        "\tif (stickReachX > 0) {",
        "\t\tstickX = nudge(stickX, stickStepX, stickReachX, held.RIGHT, held.LEFT);",
        "\t\tself.setX(self.getX() + stickX);",
        "\t}",
        "\tif (stickReachY > 0) {",
        "\t\tstickY = nudge(stickY, stickStepY, stickReachY, held.DOWN, held.UP);",
        "\t\tself.setY(self.getY() + stickY);",
        "\t}",
        "}"
      ] },
    "influenceYMovement": { "when": "positive", "yields_to": "influenceXMovement", "same_as": "influenceXMovement", "reads": ["influenceXMovement", "influenceXFactor", "influenceYFactor"], "replaces": "Projectiles.influence" },
    "controlDirection": { "when": "nonnegative", "reads": ["xspeed", "calcAngle"], "replaces": "Projectiles.control", "call": "aimByStick();",
      "code": [
        "// the owner aims it with the stick, eight ways, at its launch's x speed: eased a sixth of the",
        "// way toward the aim each engine frame when `calcAngle` is set, snapped to it otherwise. it",
        "// starts along the angle stated",
        "var aimSpeed = Math.abs({xspeed|0} * {@speed});",
        "var aimEases = {calcAngle|0} != 0;",
        "var aim = {v} * Math.PI / 180;",
        "function aimByStick() {",
        "\tvar owner = self.getOwner();",
        "\tif (owner != null && owner.getHeldControls != null) {",
        "\t\tvar held = owner.getHeldControls();",
        "\t\tvar across = held.LEFT ? -1 : (held.RIGHT ? 1 : 0);",
        "\t\tvar up = held.UP ? 1 : (held.DOWN ? -1 : 0);",
        "\t\tif (across != 0 || up != 0) {",
        "\t\t\tvar want = Math.atan2(up, across);",
        "\t\t\tif (aimEases) {",
        "\t\t\t\tvar turn = want - aim;",
        "\t\t\t\twhile (turn > Math.PI) turn -= 2 * Math.PI;",
        "\t\t\t\twhile (turn < -Math.PI) turn += 2 * Math.PI;",
        "\t\t\t\taim += turn / 6;",
        "\t\t\t} else aim = want;",
        "\t\t}",
        "\t}",
        "\tself.setXSpeed(self.flipX(Math.cos(aim) * aimSpeed));",
        "\tself.setYSpeed(-Math.sin(aim) * aimSpeed);",
        "}"
      ] },
    "trailEffect": { "when": "effect", "reads": ["trailEffectInterval", "trailEffectRotate"], "replaces": "Projectiles.trail", "call": "dropTrail();",
      "code": [
        "// its trail: its effect dropped where it is every `trailEffectInterval` engine frames (every one",
        "// for 0), turned along the way it flies when `trailEffectRotate` is set",
        "var trailEvery = {trailEffectInterval|1};",
        "var trailTurns = {trailEffectRotate|0};",
        "var trailWait = 0;",
        "function dropTrail() {",
        "\ttrailWait++;",
        "\tif (trailWait < trailEvery) return;",
        "\ttrailWait = 0;",
        "\tvar trail = match.createVfx(new VfxStats({ {@effect} }), self);",
        "\tif (trail == null || trailTurns == 0) return;",
        "\tvar across = self.flipX(self.getXSpeed());",
        "\tvar angle = Math.atan2(self.getYSpeed(), trail.isFacingRight() ? across : -across) * 180 / Math.PI;",
        "\ttrail.setRotation(trail.isFacingRight() ? angle : -angle);",
        "}"
      ] },
    "rotate": { "when": "true", "replaces": "Projectiles.rotate", "call": "faceFlight();",
      "code": [
        "// turned to face the way it flies. this engine turns an object after mirroring it, so one",
        "// facing left turns the other way round for the same climb",
        "function faceFlight() {",
        "\tvar vx = self.getXVelocity();",
        "\tvar vy = self.getYVelocity();",
        "\tif (vx == 0 && vy == 0) return;",
        "\tvar angle = Math.atan2(vy, self.isFacingRight() ? vx : -vx) * 180 / Math.PI;",
        "\tself.setRotation(self.isFacingRight() ? angle : -angle);",
        "}"
      ] }
  }
}

    "drawRect": "if ({self} != null) { var vv = {self}.vec; var va = Math.min({0}, {0} + {2}); var vb = Math.min({1}, {1} + {3}); var vc = Math.max({0}, {0} + {2}); var vd = Math.max({1}, {1} + {3}); if (vv == null) {self}.vec = { x0: va, y0: vb, x1: vc, y1: vd }; else { vv.x0 = Math.min(vv.x0, va); vv.y0 = Math.min(vv.y0, vb); vv.x1 = Math.max(vv.x1, vc); vv.y1 = Math.max(vv.y1, vd); } }",
    "drawRoundRect": "if ({self} != null) { var vv = {self}.vec; var va = Math.min({0}, {0} + {2}); var vb = Math.min({1}, {1} + {3}); var vc = Math.max({0}, {0} + {2}); var vd = Math.max({1}, {1} + {3}); if (vv == null) {self}.vec = { x0: va, y0: vb, x1: vc, y1: vd }; else { vv.x0 = Math.min(vv.x0, va); vv.y0 = Math.min(vv.y0, vb); vv.x1 = Math.max(vv.x1, vc); vv.y1 = Math.max(vv.y1, vd); } }",
    "drawEllipse": "if ({self} != null) { var vv = {self}.vec; var va = Math.min({0}, {0} + {2}); var vb = Math.min({1}, {1} + {3}); var vc = Math.max({0}, {0} + {2}); var vd = Math.max({1}, {1} + {3}); if (vv == null) {self}.vec = { x0: va, y0: vb, x1: vc, y1: vd }; else { vv.x0 = Math.min(vv.x0, va); vv.y0 = Math.min(vv.y0, vb); vv.x1 = Math.max(vv.x1, vc); vv.y1 = Math.max(vv.y1, vd); } }",
    "moveTo": "if ({self} != null) { var vv = {self}.vec; var va = {0}; var vb = {1}; var vc = {0}; var vd = {1}; if (vv == null) {self}.vec = { x0: va, y0: vb, x1: vc, y1: vd }; else { vv.x0 = Math.min(vv.x0, va); vv.y0 = Math.min(vv.y0, vb); vv.x1 = Math.max(vv.x1, vc); vv.y1 = Math.max(vv.y1, vd); } }",
    "lineTo": "if ({self} != null) { var vv = {self}.vec; var va = {0}; var vb = {1}; var vc = {0}; var vd = {1}; if (vv == null) {self}.vec = { x0: va, y0: vb, x1: vc, y1: vd }; else { vv.x0 = Math.min(vv.x0, va); vv.y0 = Math.min(vv.y0, vb); vv.x1 = Math.max(vv.x1, vc); vv.y1 = Math.max(vv.y1, vd); } }",
    "curveTo": "if ({self} != null) { var vv = {self}.vec; var va = {2}; var vb = {3}; var vc = {2}; var vd = {3}; if (vv == null) {self}.vec = { x0: va, y0: vb, x1: vc, y1: vd }; else { vv.x0 = Math.min(vv.x0, va); vv.y0 = Math.min(vv.y0, vb); vv.x1 = Math.max(vv.x1, vc); vv.y1 = Math.max(vv.y1, vd); } }",

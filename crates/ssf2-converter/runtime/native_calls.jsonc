// an object's own code written as plain Fraymakers code (compile/native.rs): the API calls it
// makes, as the engine's calls.
//
// a row is the call on the engine object it is asked of: `{self}` that object (`self`, or the
// variable holding the owner), `{0}`, `{1}` ... its arguments, `{size}` `{speed}` `{accel}` the
// units the source's numbers are scaled by. a row is a string, or an object with the `code` and
// what its value is (`returns`: bool, number, string, object, or record for one whose fields its
// code reads plainly, a rectangle or a palette), which a test of it needs to know.
//
// a call with no row here takes the runtime's own row (`api_calls.jsonc`) where that is the
// engine's calls alone. one with neither, and none of the few the writer settles itself
// (listeners, a jump by label, a stat by name), keeps the object on the runtime: the conversion reports which call it
// was, so the next row to write is the one most content needs.
{
  // who and where
  "getOwner": { "code": "{self}.getOwner()", "returns": "object" },
  "getX": { "code": "{self}.getX() / {size}", "returns": "number" },
  "getY": { "code": "{self}.getY() / {size}", "returns": "number" },
  "setX": "{self}.setX({0} * {size})",
  "setY": "{self}.setY({0} * {size})",
  "isFacingRight": { "code": "{self}.isFacingRight()", "returns": "bool" },
  "faceRight": "{self}.faceRight()",
  "faceLeft": "{self}.faceLeft()",
  "isOnGround": { "code": "{self}.isOnFloor()", "returns": "bool" },
  "getRotation": { "code": "{self}.getRotation()", "returns": "number" },
  "setRotation": "{self}.setRotation({0})",
  "resetRotation": "{self}.resetRotation()",
  "setScale": "{self}.setScaleX({0}); {self}.setScaleY({1})",
  "setVisibility": "{self}.setVisible({0})",

  // how it moves: a projectile's x speed is along the way it faces, on both engines
  "getXSpeed": { "code": "{self}.getXSpeed() / {speed}", "returns": "number" },
  "getYSpeed": { "code": "{self}.getYSpeed() / {speed}", "returns": "number" },
  "setXSpeed": "{self}.setXSpeed({0} * {speed})",
  "setYSpeed": "{self}.setYSpeed({0} * {speed})",
  // its speed set by a heading: degrees, up from the way it faces
  "angleControl": "{self}.setXSpeed({self}.flipX(Math.cos({1} * Math.PI / 180) * {0} * {speed})); {self}.setYSpeed(-Math.sin({1} * Math.PI / 180) * {0} * {speed})",

  // what it can be hit by
  "getIntangibility": { "code": "{self}.hasBodyStatus(BodyStatus.INTANGIBLE)", "returns": "bool" },
  "getInvincibility": { "code": "{self}.hasBodyStatus(BodyStatus.INVINCIBLE)", "returns": "bool" },
  "isDisposed": { "code": "{self}.isDisposed()", "returns": "bool" },

  // damage
  "getDamage": { "code": "{self}.getDamage()", "returns": "number" },
  "setDamage": "{self}.setDamage({0})",

  // its boxes hit again what they hit already
  "refreshAttackID": "{self}.reactivateHitboxes()",

  // a fighter's ends: to rest, and out of the move it is in (on the floor it stands, in the air an
  // attack ends and anything else falls)
  "toIdle": "if ({self}.getType() == EntityType.CHARACTER) {self}.toState(CState.STAND)",
  "endAnimation": "if ({self}.isOnFloor()) {self}.toState(CState.STAND); else if ({self}.inStateGroup(CStateGroup.ATTACK)) {self}.endAnimation(); else {self}.toState(CState.FALL)",
  // let go: a fighter holding someone lets them go, and one held is let go by whoever holds it
  "release": "if ({self}.getAllGrabbedFoes() != null && {self}.getAllGrabbedFoes().length > 0) {self}.releaseAllCharacters(); else for (c in match.getCharacters()) { var held = c.getAllGrabbedFoes(); if (held != null && held.indexOf({self}) >= 0) c.releaseCharacter({self}); }",
  // a jump by label on another object's clip: its owner's script runs it (`exports.__playFrame`)
  "playFrame": "if ({self}.exports.__playFrame != null) {self}.exports.__playFrame({0})",
  // the projectile a fighter fired last
  "getCurrentProjectile": { "code": "{self}.exports.__lastProj", "returns": "object" },

  // the API's own calls (`SSF2API.print`): an empty row is a call that does nothing here
  "PeptideAPI.print": "",
  // a number from the match's own random, which a rollback replays alike
  "PeptideAPI.random": { "code": "Random.getFloat(0, 1)", "returns": "number" },
  "PeptideAPI.randomInteger": { "code": "Random.getInt({0}, {1})", "returns": "number" },
  "PeptideAPI.getCamera": { "code": "match.getCamera()", "returns": "object" },
  "PeptideAPI.playSound": { "code": "AudioClip.play(self.getResource().getContent({0}))", "returns": "object" },
  "PeptideAPI.stopSound": "if ({0} != null && !Std.isOfType({0}, Float)) {0}.stop()",

  // its sounds and its end
  "playSound": { "code": "AudioClip.play({self}.getResource().getContent({0}))", "returns": "object" },
  // a sound it played, stopped (the clip `playSound` answered; a number it holds instead stops nothing)
  "stopSound": "if ({0} != null && !Std.isOfType({0}, Float)) {0}.stop()",
  "destroy": "{self}.kill()",

  // a fighter's own variables, kept by its script (a fighter still on the runtime keeps them on
  // the object it published)
  "sharedVar": "{self}.exports.__source.__vars.get({0})",
  "setSharedVar": "{self}.exports.__source.__vars.set({0}, {1})",

  // a projectile's stats its code writes (`updateProjectileStats`), as the engine's own: `{v}` the
  // value written. a stat that switches off what it declares (its trail, its turn) is the switch
  // in projectile_stats.jsonc instead
  "projectile_stats": {
    "gravity": "self.updateProjectileStats({ gravity: {v} * {accel} })",
    "maxgravity": "self.updateProjectileStats({ terminalVelocity: {v} * {speed} })",
    "max_gravity": "self.updateProjectileStats({ terminalVelocity: {v} * {speed} })",
    "ghost": "self.updateProjectileStats({ ghost: {v} })",
    // (whether it outlives the death bounds is read as it is made: written later, it changes nothing,
    // as measured on pikachu's thunder, which falls on past them to the end of its life)
    "surviveDeathBounds": "// (the source writes surviveDeathBounds here: it was read as this was made)",
    // its lifetime, from when it was made: two engine frames to a source frame
    "time_max": "life.set(Std.int({v} * 2))"
  },

  // the camera shaken
  "PeptideAPI.shakeCamera": "match.getCamera().shake({0})",

  // the API's arithmetic (`SSF2Utils`)
  "PeptideUtils.toRadians": { "code": "{0} * (Math.PI / 180)", "returns": "number" },
  "PeptideUtils.toDegrees": { "code": "{0} * (180 / Math.PI)", "returns": "number" },
  "PeptideUtils.calculateXSpeed": { "code": "{0} * Math.cos({1} * Math.PI / 180)", "returns": "number" },
  "PeptideUtils.calculateYSpeed": { "code": "{0} * Math.sin({1} * Math.PI / 180)", "returns": "number" },
  "PeptideUtils.calculateSpeed": { "code": "Math.sqrt({0} * {0} + {1} * {1})", "returns": "number" },

  // a fighter's own calls (a `{t0}` is the argument as a test, the source's way)
  "setIntangibility": "{self}.updateAnimationStats({ bodyStatus: {t0} ? BodyStatus.INTANGIBLE : BodyStatus.NONE })",
  "setInvincibility": "{self}.updateAnimationStats({ bodyStatus: {t0} ? BodyStatus.INVINCIBLE : BodyStatus.NONE })",
  "setInterruptible": "Common.setIASA({t0})",
  "getGrabbedOpponents": { "code": "{self}.getAllGrabbedFoes()", "returns": "object" },
  "flip": "if ({self}.isFacingRight()) {self}.faceLeft(); else {self}.faceRight()",
  // the one it holds drawn in front of it or behind it
  // the one it holds, and drawn behind or in front of another
  "getGrabbedOpponent": { "code": "({self}.getAllGrabbedFoes() != null && {self}.getAllGrabbedFoes().length > 0 ? {self}.getAllGrabbedFoes()[0] : null)", "returns": "object" },
  "bringBehind": "{self}.sendBehind({0})",
  "bringInFront": "{self}.bringInFront({0})",
  "swapDepthGrabbed": "if ({self}.getAllGrabbedFoes() != null && {self}.getAllGrabbedFoes().length > 0) { if ({0} == true) {self}.bringInFront({self}.getAllGrabbedFoes()[0]); else {self}.sendBehind({self}.getAllGrabbedFoes()[0]); }",
  // the one it holds shows one of its own poses, by label (its own script's jump)
  "grabbedHurtFrame": "if ({self}.getAllGrabbedFoes() != null && {self}.getAllGrabbedFoes().length > 0 && {self}.getAllGrabbedFoes()[0].exports.__playFrame != null) {self}.getAllGrabbedFoes()[0].exports.__playFrame({0})",
  // not ported: an effect or clip moved in the drawing order of the stage (this engine draws an
  // effect on the layer it was made on)
  "pushEffectBehind": "",
  // the stage behind the fighters dimmed, as for a final smash, and back
  "darken": { "code": "darkenStage(true)", "helper": "darkenStage" },
  "lighten": { "code": "darkenStage(false)", "helper": "darkenStage" },
  "killDarkener": { "code": "darkenStage(false)", "helper": "darkenStage" },
  // not ported: a fighter turned metal (`gap` notes it in the report)
  "setMetalStatus": { "code": "", "gap": "turns metal, which nothing here shows" },
  "swapDepths": "",
  "swapChildren": "",
  "getMidground": { "code": "stage", "returns": "object" },
  "PeptideAPI.getStage": { "code": "stage", "returns": "object" },
  // an item asked to fly free (its own script throws it)
  "toToss": "if ({self}.exports.__ask != null) {self}.exports.__ask(\"toss\", null)",
  // a fighter grabbed by the one with that id; let go by whoever holds it
  "getUID": { "code": "{self}.getUid()", "returns": "number" },
  "grab": "for (c in match.getCharacters()) if (c.getUid() == {0} && c != {self}) c.attemptGrab({self})",
  "grabRelease": "if ({self}.getAllGrabbedFoes() != null && {self}.getAllGrabbedFoes().length > 0) {self}.releaseAllCharacters(); else for (c in match.getCharacters()) { var held = c.getAllGrabbedFoes(); if (held != null && held.indexOf({self}) >= 0) c.releaseCharacter({self}); }",
  "isEqual": { "code": "({0} == {self})", "returns": "bool" },
  "camFocus": "match.getCamera().addTimedTarget({self}, {0} * 2)",
  // the camera's targets, on the camera (`PeptideAPI.getCamera()`)
  "addTarget": "{self}.addTarget({0})",
  "deleteTarget": "{self}.deleteTarget({0})",
  "addForcedTarget": "{self}.addForcedTarget({0})",
  "deleteForcedTarget": "{self}.deleteForcedTarget({0})",
  // not ported: the camera's zoom, which this engine frames for itself (as on the runtime)
  "updateCameraParameters": { "code": "", "gap": "sets the camera's zoom, which this engine frames for itself" },
  "getCameraParameter": { "code": "null", "returns": "object", "gap": "sets the camera's zoom, which this engine frames for itself" },
  // not ported, as on the runtime: a named box's rectangle
  "getHitBox": { "code": "null", "returns": "rect" },
  // its palette, as the runtime answers it: none set here
  "paletteData": { "code": "{ paletteSwap: { colors: [], replacements: [] }, paletteSwapPA: { colors: [], replacements: [] } }", "returns": "record" },
  // an object it made takes its colours (an effect has none to take, as on the runtime)
  "applyPalette": "if ({0} != null && {0}.getType() == EntityType.PROJECTILE) {0}.setCostumeIndex({self}.getCostumeIndex())",
  // a list's and a text's own calls
  "slice": { "code": "{self}.slice({0}, {1})", "returns": "object" },
  "push": "{self}.push({0})",
  "splice": { "code": "{self}.splice({0}, {1})", "returns": "object" },
  "split": { "code": "{self}.split({0})", "returns": "object" },
  "toString": { "code": "Std.string({self})", "returns": "string" },
  // the match's clock, in the source's frames
  "PeptideAPI.getElapsedFrames": { "code": "Std.int(match.getElapsedFrames() / 2)", "returns": "number" },
  "PeptideAPI.randomBetween": { "code": "Random.getInt({0}, {1})", "returns": "number" },
  "PeptideAPI.randomUnit": { "code": "Random.getFloat(0, 1)", "returns": "number" },

  // a projectile's states, by the source's names: over (ended, or ending), else not
  "projectile_states": {
    "DEAD": "({self}.isDisposed() || {self}.getState() == PState.DESTROYING)",
    "IDLE": "!({self}.isDisposed() || {self}.getState() == PState.DESTROYING)"
  },

  // the API's records, made with `new` (a final smash's timer bar, which no meter here draws; a
  // computer player's controls, which nothing here plays): their fields read and written plainly
  "records": {
    "PeptideFinalSmashBar": "{ most: {0}, left: {0} }",
    "PeptideControlBits": "{}"
  },
  // the calls a record answers, by name (`{self}` the record)
  "record_calls": {
    "addToDamageMeter": "",
    "removeFromDamageMeter": "",
    "updateBar": "{self}.left = {0}",
    "reset": ""
  },

  // the source's names for the kinds of object, which content compares `getType()` with
  "types": {
    "SSF2Character": "EntityType.CHARACTER",
    "SSF2Projectile": "EntityType.PROJECTILE",
    "SSF2Item": "EntityType.ITEM",
    "SSF2Enemy": "EntityType.CUSTOM_GAME_OBJECT",
    // (a stage's path node, which no object here is)
    "SSF2Beacon": "-1"
  }
}

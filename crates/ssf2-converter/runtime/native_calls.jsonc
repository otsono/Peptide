    "getChildIndex": "0",
    "setChildIndex": "",
    // (two boxes overlapping)
    "intersects": "({self} != null && {0} != null && {self}.x < {0}.x + {0}.width && {0}.x < {self}.x + {self}.width && {self}.y < {0}.y + {0}.height && {0}.y < {self}.y + {self}.height)",
    // (a point moved by an offset)
    "offset": "if ({self} != null) { {self}.x += {0}; {self}.y += {1}; }",
    "clone": "({self} == null ? null : { x: {self}.x, y: {self}.y, width: {self}.width, height: {self}.height })",
    // (a clip its code made, drawn into as its code runs: this engine draws no shapes, so what it

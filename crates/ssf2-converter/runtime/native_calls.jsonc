// an object's own code written as plain Fraymakers code (compile/native.rs): the API calls it
// makes, as the engine's calls.
//
// a row is the call on the engine object it is asked of: `{self}` that object (`self`, or the
// variable holding the owner), `{0}`, `{1}` ... its arguments (`{,1}` one the call may leave off,
// written after a comma where it passes one), `{size}` `{speed}` `{accel}` the
// units the source's numbers are scaled by. a row is a string, or an object with the `code` and
// what its value is (`returns`: bool, number, string, object, or record for one whose fields its
// code reads plainly, a rectangle or a palette), which a test of it needs to know. an API call
// keyed `PeptideAPI.<call>#name` is the row for that call asked by a name written out.
//
// a call with no row here, and none of the few the writer settles itself (listeners, a jump by
// label, a stat by name), is left out of the script and said in the object's gaps
// (`port_report.json`), so the next row to write is the one most content needs. a row with a
// `gap` does what its `code` says and says the rest.
{
  // who and where
  "getOwner": { "code": "{self}.getOwner()", "returns": "object" },
  "setOwner": "if ({0} != null) {self}.setOwner({0})",
  // (places in the source's units; a stage's and its objects' in the stage's own space, from the
  // source's origin, `{ox}` `{oy}`, which is the engine's for everyone else)
  "getX": { "code": "{self}.getX() / {size} + {ox}", "returns": "number" },
  "getY": { "code": "{self}.getY() / {size} + {oy}", "returns": "number" },
  "setX": "{self}.setX(({0} - {ox}) * {size})",
  "setY": "{self}.setY(({0} - {oy}) * {size})",
  // (a stage's and its objects' places: in the stage's space, from where each object's clip is
  // registered, `stagePlace`)
  "getX@stage": { "code": "placeX({self})", "helper": "stagePlace", "returns": "number" },
  "getY@stage": { "code": "placeY({self})", "helper": "stagePlace", "returns": "number" },
  "setX@stage": { "code": "setPlaceX({self}, {0})", "helper": "stagePlace" },
  "setY@stage": { "code": "setPlaceY({self}, {0})", "helper": "stagePlace" },
  "isFacingRight": { "code": "{self}.isFacingRight()", "returns": "bool" },
  "faceRight": "{self}.faceRight()",
  "faceLeft": "{self}.faceLeft()",
  "isOnGround": { "code": "{self}.isOnFloor()", "returns": "bool" },
  "getRotation": { "code": "{self}.getRotation()", "returns": "number" },
  "setRotation": "{self}.setRotation({0})",
  "resetRotation": "{self}.resetRotation()",
  "setScale": "{self}.setScaleX({0}); {self}.setScaleY({1})",
  "setVisibility": "{self}.setVisible({0})",
  "setAlpha": "{self}.setAlpha({0})",
  "getAlpha": { "code": "{self}.getAlpha()", "returns": "number" },
  // its clip, where nothing reads into it: the object, which shows it
  "getMC": { "code": "{self}", "returns": "object" },
  // a point inside what it covers (a region of the stage's: its rectangle)
  "hitTestRect": { "code": "({self} != null && {self}.hitTestRect != null && {self}.hitTestRect({0}, {size}))", "returns": "bool" },
  "hitTestPoint": { "code": "({self} != null && {self}.hitTestPoint != null && {self}.hitTestPoint(({0} - {ox}) * {size}, ({1} - {oy}) * {size}))", "returns": "bool" },

  // how it moves: a projectile's x speed is along the way it faces, on both engines
  "getXSpeed": { "code": "{self}.getXSpeed() / {speed}", "returns": "number" },
  "getYSpeed": { "code": "{self}.getYSpeed() / {speed}", "returns": "number" },
  "setXSpeed": "{self}.setXSpeed({0} * {speed})",
  "setYSpeed": "{self}.setYSpeed({0} * {speed})",
  // a launch given outright: a knockback (the source's units) or a speed, at a heading in degrees
  "applyKnockback": "{self}.setXKnockback(Math.cos(({1}) * Math.PI / 180) * ({0}) * 0.213725 * {speed}); {self}.setYKnockback(-Math.sin(({1}) * Math.PI / 180) * ({0}) * 0.213725 * {speed})",
  "applyKnockbackSpeed": "{self}.setXKnockback(Math.cos(({1}) * Math.PI / 180) * ({0}) * {speed}); {self}.setYKnockback(-Math.sin(({1}) * Math.PI / 180) * ({0}) * {speed})",
  // its speed set by a heading: degrees, up from the way it faces
  "angleControl": "{self}.setXSpeed({self}.flipX(Math.cos({1} * Math.PI / 180) * {0} * {speed})); {self}.setYSpeed(-Math.sin({1} * Math.PI / 180) * {0} * {speed})",

  // what it can be hit by
  "getIntangibility": { "code": "{self}.hasBodyStatus(BodyStatus.INTANGIBLE)", "returns": "bool" },
  "getInvincibility": { "code": "{self}.hasBodyStatus(BodyStatus.INVINCIBLE)", "returns": "bool" },
  "isDisposed": { "code": "{self}.isDisposed()", "returns": "bool" },

  // damage
  "getDamage": { "code": "{self}.getDamage()", "returns": "number" },
  "setDamage": "{self}.setDamage({0})",
  // healed: its damage less that much, down to none
  "recover": "{self}.addDamage(-Math.min({0}, {self}.getDamage()))",

  // its boxes hit again what they hit already
  "refreshAttackID": "{self}.reactivateHitboxes()",

  // a fighter's ends: to rest, and out of the move it is in (on the floor it stands, in the air an
  // attack ends and anything else falls)
  "toIdle": "if ({self}.getType() == EntityType.CHARACTER) {self}.toState(CState.STAND)",
  "endAnimation": "if ({self}.isOnFloor()) {self}.toState(CState.STAND); else if ({self}.inStateGroup(CStateGroup.ATTACK)) {self}.endAnimation(); else {self}.toState(CState.FALL)",
  // let go: a fighter holding someone lets them go, and one held is let go by whoever holds it
  "release": "if ({self}.getAllGrabbedFoes() != null && {self}.getAllGrabbedFoes().length > 0) {self}.releaseAllCharacters(); else for (c in match.getCharacters()) { var held = c.getAllGrabbedFoes(); if (held != null && held.indexOf({self}) >= 0) c.releaseCharacter({self}); }",
  // a jump by label on another object's clip: its owner's script runs it (`exports.__playFrame`)
  "playFrame": "if ({self}.exports.__playFrame != null) {self}.exports.__playFrame({0})",
  // the projectile a fighter fired last
  "getCurrentProjectile": { "code": "{self}.exports.__lastProj", "returns": "object" },

  // the API's own calls (`SSF2API.print`): an empty row is a call that does nothing here
  "PeptideAPI.print": "",
  // a stage set up for the game's quality tier: every setting is on here, so nothing is hidden
  // the stage's quality settings: at the highest (as the match runs here), the clips of its second
  // list animate whatever their own code stops (`qualityPlays`)
  "PeptideStageQuality.init": { "code": "qualityPlays({1})", "helper": "qualityPlays" },
  // (an object's own debug print, the same)
  "trace": "",
  // a number from the match's own random, which a rollback replays alike
  "PeptideAPI.random": { "code": "Random.getFloat(0, 1)", "returns": "number" },
  "PeptideAPI.randomInteger": { "code": "Random.getInt({0}, {1})", "returns": "number" },
  "PeptideAPI.getCamera": { "code": "match.getCamera()", "returns": "object" },
  "PeptideAPI.playSound": { "code": "AudioClip.play(self.getResource().getContent({0}))", "returns": "object" },
  "PeptideAPI.stopSound": "if ({0} != null && !Std.isOfType({0}, Float)) {0}.stop()",

  // its sounds and its end
  "playSound": { "code": "AudioClip.play({self}.getResource().getContent({0}))", "returns": "object" },
  // a sound it played, stopped (the clip `playSound` answered; a number it holds instead stops nothing)
  "stopSound": "if ({0} != null && !Std.isOfType({0}, Float)) {0}.stop()",
  "destroy": "{self}.kill()",
  // a fade it steps a frame at a time, as its code asks
  "fadeIn": { "code": "fadeTo({self}, 1)", "helper": "fadeTo" },
  "fadeOut": { "code": "fadeTo({self}, 0)", "helper": "fadeTo" },
  "isFading": { "code": "fadingNow.get()", "helper": "fadeTo", "returns": "bool" },
  "resetFade": { "code": "fadingNow.set(false); {self}.setAlpha(1)", "helper": "fadeTo" },

  // a fighter's own variables, kept by its script (a fighter still on the runtime keeps them on
  // the object it published)
  "sharedVar": { "code": "sharedVarsOf({self}).get({0})", "helper": "sharedVarsOf" },
  "setSharedVar": { "code": "sharedVarsOf({self}).set({0}, {1})", "helper": "sharedVarsOf" },

  // a projectile's stats its code writes (`updateProjectileStats`), as the engine's own: `{v}` the
  // value written. a stat that switches off what it declares (its trail, its turn) is the switch
  // in projectile_stats.jsonc instead
  "projectile_stats": {
    "gravity": "self.updateProjectileStats({ gravity: {v} * {accel} })",
    "maxgravity": "self.updateProjectileStats({ terminalVelocity: {v} * {speed} })",
    "max_gravity": "self.updateProjectileStats({ terminalVelocity: {v} * {speed} })",
    "ghost": "self.updateProjectileStats({ ghost: {v} })",
    // (whether it outlives the death bounds is read as it is made: written later, it changes nothing,
    // as measured on pikachu's thunder, which falls on past them to the end of its life)
    "surviveDeathBounds": "// (the source writes surviveDeathBounds here: it was read as this was made)",
    // its lifetime, from when it was made: two engine frames to a source frame
    "time_max": "life.set(Std.int({v} * 2))"
  },

  // the camera shaken
  "PeptideAPI.shakeCamera": "match.getCamera().shake({0})",

  // the API's arithmetic (`SSF2Utils`)
  "PeptideUtils.toRadians": { "code": "Math.toRadians({0})", "returns": "number" },
  "PeptideUtils.toDegrees": { "code": "Math.toDegrees({0})", "returns": "number" },
  "PeptideUtils.calculateXSpeed": { "code": "Math.calculateXVelocity({0}, {1})", "returns": "number" },
  "PeptideUtils.calculateYSpeed": { "code": "Math.calculateYVelocity({0}, {1})", "returns": "number" },
  "PeptideUtils.calculateSpeed": { "code": "Math.calculateSpeed({0}, {1})", "returns": "number" },
  // (the engine's own: its angle between runs -180 up to 180, the source's 0 up to 360; its velocity
  // calls take the speed first)
  "PeptideUtils.forceBase360": { "code": "Math.modulo({0}, 360)", "returns": "number" },
  "PeptideUtils.calculateDifferenceBetweenAngles": { "code": "Math.angleDifference({0}, {1})", "returns": "number" },
  "PeptideUtils.getAngleBetween": { "code": "Math.modulo(Math.getAngleBetween(Point.create({0}.x, {0}.y), Point.create({1}.x, {1}.y)), 360)", "returns": "number" },
  "PeptideUtils.getVelocityVector": { "code": "{ x: Math.calculateXVelocity({0}, {1}), y: Math.calculateYVelocity({0}, {1}) }", "returns": "rect" },

  // a fighter's own calls (a `{t0}` is the argument as a test, the source's way)
  "setIntangibility": "{self}.updateAnimationStats({ bodyStatus: {t0} ? BodyStatus.INTANGIBLE : BodyStatus.NONE })",
  "setInvincibility": "{self}.updateAnimationStats({ bodyStatus: {t0} ? BodyStatus.INVINCIBLE : BodyStatus.NONE })",
  "setInterruptible": "Common.setIASA({t0})",
  "getGrabbedOpponents": { "code": "{self}.getAllGrabbedFoes()", "returns": "object" },
  "flip": "if ({self}.isFacingRight()) {self}.faceLeft(); else {self}.faceRight()",
  // the one it holds drawn in front of it or behind it
  // the one it holds, and drawn behind or in front of another
  "getGrabbedOpponent": { "code": "({self}.getAllGrabbedFoes() != null && {self}.getAllGrabbedFoes().length > 0 ? {self}.getAllGrabbedFoes()[0] : null)", "returns": "object" },
  "bringBehind": "{self}.sendBehind({0})",
  "bringInFront": "{self}.bringInFront({0})",
  "swapDepthGrabbed": "if ({self}.getAllGrabbedFoes() != null && {self}.getAllGrabbedFoes().length > 0) { if ({0} == true) {self}.bringInFront({self}.getAllGrabbedFoes()[0]); else {self}.sendBehind({self}.getAllGrabbedFoes()[0]); }",
  // the one it holds shows one of its own poses, by label (its own script's jump)
  "grabbedHurtFrame": "if ({self}.getAllGrabbedFoes() != null && {self}.getAllGrabbedFoes().length > 0 && {self}.getAllGrabbedFoes()[0].exports.__playFrame != null) {self}.getAllGrabbedFoes()[0].exports.__playFrame({0})",
  // not ported: an effect or clip moved in the drawing order of the stage (this engine draws an
  // effect on the layer it was made on)
  "pushEffectBehind": "",
  // the stage behind the fighters dimmed, as for a final smash, and back
  "darken": { "code": "darkenStage(true)", "helper": "darkenStage" },
  "lighten": { "code": "darkenStage(false)", "helper": "darkenStage" },
  "killDarkener": { "code": "darkenStage(false)", "helper": "darkenStage" },
  // not ported: a fighter turned metal (`gap` notes it in the report)
  "setMetalStatus": { "code": "", "gap": "turns metal, which nothing here shows" },
  // (a projectile's gravity, written as it flies: as its declared one converts)
  "modifyGravity": "{self}.updateProjectileStats({ gravity: {0} * {accel} })",
  // (the clip its animation shows, asked of itself: it is its own clip here)
  "stanceClip": { "code": "{self}", "returns": "object" },
  // (whether a projectile flies on through a wall or the floor it meets, and whether a platform
  // keeps a rider's speed: settings this engine's objects have none of)
  "modifyContinueOnCrash": { "code": "", "gap": "sets whether it flies on through a wall it meets, which this engine's projectiles have no setting for" },
  "modifyContinueOnGround": { "code": "", "gap": "sets whether it flies on along the floor it meets, which this engine's projectiles have no setting for" },
  "setConserveHorizontalMomentum": { "code": "", "gap": "sets whether a rider keeps its speed across, which this engine's platforms have no setting for" },
  "setConserveUpwardMomentum": { "code": "", "gap": "sets whether a rider keeps its speed up, which this engine's platforms have no setting for" },
  "setConserveDownwardMomentum": { "code": "", "gap": "sets whether a rider keeps its speed down, which this engine's platforms have no setting for" },
  "swapDepths": "",
  "swapChildren": "",
  "getMidground": { "code": "stage", "returns": "object" },
  "PeptideAPI.getStage": { "code": "stage", "returns": "object" },
  // an item asked to fly free (its own script throws it)
  "toToss": "if ({self}.exports.__ask != null) {self}.exports.__ask(\"toToss\", null)",
  "toHeld": "if ({self} != null && {self}.exports != null && {self}.exports.__ask != null) {self}.exports.__ask(\"toHeld\", null)",
  // a fighter grabbed by the one with that id; let go by whoever holds it
  "getUID": { "code": "{self}.getUid()", "returns": "number" },
  "grab": { "code": "grabBy({self}, {0})", "helper": "grabBy", "returns": "bool" },
  "grabRelease": "if ({self}.getAllGrabbedFoes() != null && {self}.getAllGrabbedFoes().length > 0) {self}.releaseAllCharacters(); else for (c in match.getCharacters()) { var held = c.getAllGrabbedFoes(); if (held != null && held.indexOf({self}) >= 0) c.releaseCharacter({self}); }",
  "isEqual": { "code": "({0} == {self})", "returns": "bool" },
  "camFocus": "match.getCamera().addTimedTarget({self}, {0} * 2)",
  // the camera's targets, on the camera (`PeptideAPI.getCamera()`)
  "addTarget": "{self}.addTarget({0})",
  "deleteTarget": "{self}.deleteTarget({0})",
  "addForcedTarget": "{self}.addForcedTarget({0})",
  "deleteForcedTarget": "{self}.deleteForcedTarget({0})",
  // not ported: the camera's zoom, which this engine frames for itself (as on the runtime)
  "updateCameraParameters": { "code": "", "gap": "sets the camera's zoom, which this engine frames for itself" },
  "getCameraParameter": { "code": "cameraParameter({0})", "helper": "cameraParameter", "returns": "number" },
  // not ported, as on the runtime: a named box's rectangle
  "getHitBox": { "code": "null", "returns": "rect" },
  // its palette, as the runtime answers it: none set here
  "paletteData": { "code": "{ paletteSwap: { colors: [], replacements: [] }, paletteSwapPA: { colors: [], replacements: [] } }", "returns": "record" },
  // an object it made takes its colours (an effect has none to take, as on the runtime)
  "applyPalette": "if ({0} != null && {0}.getType() == EntityType.PROJECTILE) {0}.setCostumeIndex({self}.getCostumeIndex())",
  // an item's own calls, on its handler (`runtime/native/item.hx`)
  "setFrameInterrupt": "frameInterrupt.set({0})",
  "isZDropped": { "code": "zDropped.get()", "returns": "bool" },
  "getHolder": { "code": "holder.get()", "returns": "object" },
  // its holder letting go of the item it holds, asked by another object (the item itself)
  "dropItem": "if ({self} != null && {self}.exports.__dropItem != null) {self}.exports.__dropItem()",
  // an item's own stats written by its code: the engine's stat for each it keeps (`{v}` the value)
  "item_stats": {
    "gravity": "gravity: {v} * {accel}",
    "max_gravity": "terminalVelocity: {v} * {speed}",
    "maxgravity": "terminalVelocity: {v} * {speed}",
    "ghost": "ghost: {v}",
    // (kept by the item handler, runtime/native/item.hx: a statement, `;` ended)
    "canPickup": "pickupOn.set({v});",
    // its life while free, from when it was made: two engine frames to a source frame
    "time_max": "life.set(Std.int({v} * 2));"
  },
  // an item stat its own code reads that its handler keeps as it runs (`{declared}` what it declares)
  "item_stat_reads": {
    "canPickup": "({declared} != false && pickupOn.get())"
  },
  // another object's size (its own is what it declares: src/compile/native.rs), and its scale
  "getWidth": { "code": "sizeOf({self}, false)", "helper": "sizeOf", "returns": "number" },
  "getHeight": { "code": "sizeOf({self}, true)", "helper": "sizeOf", "returns": "number" },
  "getScale": { "code": "{ x: {self}.getScaleX(), y: {self}.getScaleY() }", "returns": "record" },
  // the box an object takes up, and a rectangle's own calls (the engine's `Rectangle`)
  "getBoundsRect": { "code": "boundsRectOf({self}, {ox}, {oy})", "helper": "boundsRectOf", "returns": "object" },
  "offset": "{self}.x += {0}; {self}.y += {1}",
  "intersection": { "code": "{self}.intersection({0})", "returns": "object" },
  "intersects": { "code": "{self}.intersects({0})", "returns": "bool" },
  "isEmpty": { "code": "{self}.isEmpty()", "returns": "bool" },
  // a list's and a text's own calls
  // (a text cut as Flash cuts one, a list by its own: whichever it is as it runs)
  "slice": { "code": "anySlice({self}, {0}{,1})", "helper": "textSlice", "returns": "object" },
  "shift": { "code": "{self}.shift()", "returns": "object" },
  "pop": { "code": "{self}.pop()", "returns": "object" },
  "unshift": "{self}.unshift({0})",
  "indexOf": { "code": "{self}.indexOf({0})", "returns": "number" },
  "push": "{self}.push({0})",
  "splice": { "code": "{self}.splice({0}, {1})", "returns": "object" },
  "split": { "code": "{self}.split({0})", "returns": "object" },
  "join": { "code": "joinedList({self}{,0})", "helper": "joinedList", "returns": "string" },
  // (a text joined to another, a list to another list: whichever it is as it runs)
  "concat": { "code": "anyConcat({self}, {0})", "helper": "textSlice", "returns": "object" },
  "lastIndexOf": { "code": "{self}.lastIndexOf({0})", "returns": "number" },
  "charAt": { "code": "{self}.charAt({0})", "returns": "string" },
  "charCodeAt": { "code": "{self}.charCodeAt({0})", "returns": "number" },
  "substr": { "code": "{self}.substr({0}{,1})", "returns": "string" },
  "substring": { "code": "{self}.substring({0}{,1})", "returns": "string" },
  "toUpperCase": { "code": "{self}.toUpperCase()", "returns": "string" },
  "toLowerCase": { "code": "{self}.toLowerCase()", "returns": "string" },
  "toString": { "code": "Std.string({self})", "returns": "string" },
  // the match's clock, in the source's frames
  // the stage's structure a line crosses (`ignoreFallthrough` passes over one dropped through)
  // colour settings on an object: its alpha, an hsbc filter, a channel shader
  "setColorFilters": { "code": "colorFilters({self}, {0})", "helper": "colorFilters" },
  "PeptideUtils.setColorFilters": { "code": "colorFilters({0}, {1})", "helper": "colorFilters" },
  // a hit dealt outright, its launch worked out as the source's
  "takeDamage": { "code": "takeDamageOf({self}, {0}{,1})", "helper": "takeDamageOf", "returns": "bool" },
  // to where the one it grabbed is
  "toGrabbed": "if ({self}.getGrabbedFoe() != null) { {self}.setX({self}.getGrabbedFoe().getX()); {self}.setY({self}.getGrabbedFoe().getY()); }",
  // into its grab's hold with the one it holds (let go of in the air)
  "toGrabbing": "if ({self}.getAllGrabbedFoes() != null && {self}.getAllGrabbedFoes().length == 1) { if (!{self}.isOnFloor()) {self}.releaseAllCharacters(); else {self}.toState(CState.GRAB_HOLD); }",
  // the one it holds let go of (the launch the source spits it out with is not ported)
  "ejectOpponent": { "code": "{self}.releaseAllCharacters()", "gap": "ejectOpponent: the launch of the one spat out" },
  // the attack it is in, by the source's name for it (its clip's label): what a fighter publishes,
  // else the animation it plays
  "getCurrentFrame": { "code": "({self} == null ? null : ({self}.exports.__label != null ? {self}.exports.__label() : {self}.getAnimation()))", "returns": "string" },
  // how long its attack has run, in the source's frames (this animation's, where an attack plays several)
  "getExecTime": { "code": "Std.int(({self}.getCurrentFrame() + 1) / 2)", "returns": "number" },
  // a check its code makes of each hit its own boxes land, before the hit lands: one it answers
  // true is not landed (dedede's attacks pass through his own gordo, a popped balloon hurts no one)
  "setHurtInterrupt": { "code": "hurtInterrupt({self}, {0})", "helper": "hurtInterrupt" },
  // the match's winners and losers, which this engine tells no fighter while it plays
  "PeptideAPI.getWinners": { "code": "[]", "returns": "object", "gap": "getWinners: the match's winners" },
  "PeptideAPI.getLosers": { "code": "[]", "returns": "object", "gap": "getLosers: the match's losers" },
  // two objects' boxes against each other, each by the source's kind of box: where they meet
  "PeptideAPI.hitboxTest": { "code": "boxesMeet({0}, {1}, {2}, {3})", "helper": "boxesMeet", "returns": "object" },
  // the colours it is drawn in, changed by its code: each colour it lists drawn as its replacement
  // (its costume's record: the swap is its `paletteSwap`)
  "setPaletteData": { "code": "paletteDataOn({self}, {0})", "helper": "paletteOn" },
  // the stage's camera and death bounds, in the source's units
  "PeptideAPI.getCamBounds": { "code": "boundsOf(stage.getCameraBounds())", "helper": "boundsOf", "returns": "rect" },
  "PeptideAPI.getDeathBounds": { "code": "boundsOf(stage.getDeathBounds())", "helper": "boundsOf", "returns": "rect" },
  // (the stage's own, asked of the stage)
  "getCameraBounds": { "code": "boundsOf(stage.getCameraBounds())", "helper": "boundsOf", "returns": "rect" },
  "getDeathBounds": { "code": "boundsOf(stage.getDeathBounds())", "helper": "boundsOf", "returns": "rect" },
  // a value as another class: the value itself
  "PeptideUtils.cast": { "code": "{0}", "returns": "object" },
  // the clip of the hat a copied power gives: the engine draws none here, and its colours change nothing
  "copyHatClip": { "code": "null", "returns": "object", "gap": "the hat a copied power gives (getKirbyHatMC)" },
  // another engine object worn in its costume (an effect keeps its own colours, as on the runtime)
  "applyPaletteToEffect": "if ({0} != null && {0} != {self} && {0}.getType() != EntityType.VFX) {0}.setCostumeIndex({self}.getCostumeIndex())",
  // a clip recoloured by its code: each colour the swap lists drawn as its replacement
  "PeptideUtils.replacePalette": { "code": "paletteOn({0}, {1})", "helper": "paletteOn" },
  // the game's quality settings: every one on, as both engines run here
  "PeptideAPI.getQualitySettings": { "code": "{ weather: true, stage_effects: \"enabled\", ambient_lighting: \"enabled\", global_effects: true }", "returns": "record" },
  // the match's fighters
  "PeptideAPI.getCharacters": { "code": "match.getCharacters()", "returns": "object" },
  // the players in the match, in player order
  "PeptideAPI.getPlayers": { "code": "match.getCharacters()", "returns": "object" },

  "resetJumps": "{self}.setDoubleJumpCount(0)",
  // the fighter not drawn for a while (in the source's frames), then drawn again
  "setInvisibilityTimer": {"code": "unseenFor({self}, {0})", "helper": "unseenFor", "returns": "object"},
  "maxOutJumps": "{self}.setDoubleJumpCount({self}.getCharacterStat(\"doubleJumpSpeeds\").length)",
  "getMidairJumpCount": "{self}.getDoubleJumpCount()",
  "releaseOpponent": "{self}.releaseAllCharacters()",
  "grabReleaseOpponent": "{self}.releaseAllCharacters()",
  "releaseLedge": "{self}.releaseLedge()",
  "getCostume": "{self}.getCostumeIndex()",
  "getLives": "{self}.getLives()",
  "getID": "{self}.getUid()",
  "getTeamID": "{self}.getTeam()",
  "getMetalStatus": "false",
  "isForcedCrash": "false",
  "isCPU": "false",
  "cpuLevel": "0",
  "cpuAction": "0",
  "cpuForcedAction": "-1",
  "cpuTarget": "null",
  "getShieldPower": "1",
  "tetherCount": "0",
  "isStandby": "false",
  "getStandby": "false",
  "inFinalSmash": "false",
  "finalCutscene": "null",
  "copyPower": "null",
  "getBounceSpeed": "0",
  "nearTopLeft": "false",
  "nearTopRight": "false",
  "nearBottomLeft": "false",
  "nearBottomRight": "false",
  "shake": "match.getCamera().shake({0})",
  "getLinkageID": "{self}.exports == null ? null : {self}.exports.__linkageId",
  "getUses": "{self}.exports.__uses == null ? 0 : {self}.exports.__uses",
  "isFacingLeft": "!{self}.isFacingRight()",
  "isIntangible": "{self}.hasBodyStatus(BodyStatus.INTANGIBLE)",
  "isReversed": "{self}.isReversed != null && {self}.isReversed()",
  "inHitStun": "{self}.getHitstop() > 0",
  "addToCamera": "match.getCamera().addTarget({self})",
  "camUnfocus": "match.getCamera().deleteTimedTarget({self})",
  "dispose": "null",
  "endFinalCutscene": "null",
  "lightFlash": "null",
  // an item lying free within its reach taken up, as a press would take it up: whether one was
  "pickupItem": {"code": "pickUpNear({self})", "helper": "pickUpNear", "returns": "bool"},
  "playCpuInputs": "null",
  "removeStageFocus": {"code": "stageFocus(0)", "helper": "stageFocus"},
  "resetCpuInputs": "null",
  "setCamBoxSize": "null",
  "setAccelFriction": {"code": "null", "returns": "object", "gap": "setAccelFriction: a surface's own friction"},
  "setDecelFriction": {"code": "null", "returns": "object", "gap": "setDecelFriction: a surface's own friction"},
  "setCpuQueue": "null",
  "setFinalMeter": "null",
  "setMode": "null",
  // the camera framing the whole stage for a while (in the source's frames), its fighters
  // not followed (`CameraMode.STAGE`), then going back to them
  "setStageFocus": {"code": "stageFocus({0})", "helper": "stageFocus", "returns": "object"},
  "setTeamID": {"code": "null", "returns": "object", "gap": "setTeamID: changing a fighter's team"},
  "startFinalCutscene": {"code": "null", "returns": "object", "gap": "startFinalCutscene: a final smash cutscene"},
  "swapFighter": {"code": "null", "returns": "object", "gap": "swapFighter: turning into another fighter"},
  "throbDamage": "null",
  "toFinalForm": {"code": "null", "returns": "object", "gap": "toFinalForm: a final form"},
  "flipX": "{self}.flipX({0})",
  "resetKnockback": "{self}.setXKnockback(0); {self}.setYKnockback(0)",
  "resetMovement": "{self}.setXSpeed(0); {self}.setYSpeed(0)",
  "removeFromCamera": "{self}.getType() == EntityType.CHARACTER ? null : match.getCamera().deleteTarget({self})",
  "setPosition": "{self}.setX({0} * {size}); {self}.setY({1} * {size})",
  "addHUDDetection": {"code": "null", "returns": "object", "gap": "addHUDDetection: the HUD seeing what is behind it"},
  "removeHUDDetection": {"code": "null", "returns": "object", "gap": "removeHUDDetection: the HUD seeing what is behind it"},
  "getSnapshot": {"code": "null", "returns": "object", "gap": "getSnapshot: the all-star mode's run so far"},
  "warioWareEffect": {"code": "null", "returns": "object", "gap": "warioWareEffect: the microgames' screen effect"},
  "getTopLeftPoint": "Point.create(match.getCamera().getX() / {size}, match.getCamera().getY() / {size})",
  "getMode": "match.getCamera().getMode()",
  "activateItem": "{self}.exports.__askActive = true",
  "deactivateItem": "{self}.exports.__askActive = false",
  // star KOs turned off: a fighter past the top is KO'd at once, which is the only KO this engine
  // has, so the stage plays as its source does; turned on, the KO still lands
  "setStarKOEnabled": {"code": "null", "returns": "object"},
  "updatePlayerSettings": {"code": "null", "returns": "object", "gap": "updatePlayerSettings: a player's respawn place"},
  "breakTarget": "{self}.isDisposed() ? null : {self}.kill()",
  "initialize": "null",
  "update": "null",
  "getSizeStatus": "0",
  // a fighter shut in a barrel: out of its own control (the engine's disabled state) until the
  // stage's code lets it go; the stage holds it, hides it and moves it itself
  "toBarrel": {"code": "if ({self}.getType() == EntityType.CHARACTER) {self}.toState(CState.DISABLED)", "returns": "object"},
  // every projectile in the match
  "PeptideAPI.getProjectiles": { "code": "match.getProjectiles()", "returns": "object" },
  // the game's own match and progress calls, which nothing here has: a fighter put in the match by
  // code, a player's control handed over, a final smash given, lives set, an unlock earned
  "PeptideAPI.spawnCharacter": { "code": "null", "returns": "object", "gap": "spawnCharacter: a fighter put in the match by code" },
  "setHumanControl": { "code": "", "gap": "setHumanControl: a player's control handed to another fighter" },
  "grantFinalSmash": { "code": "false", "returns": "bool", "gap": "grantFinalSmash: a final smash given by code" },
  "setLives": { "code": "", "gap": "setLives: a fighter's stock set by code" },
  "PeptideAPI.triggerUnlock": { "code": "", "gap": "triggerUnlock: the game's unlockables" },
  // a timer taken off by the function it runs, where this engine takes one off by its id
  "removeTimer": { "code": "", "gap": "removeTimer: a timer taken off by the function it runs" },
  // screen KOs turned off: a fighter past the top is KO'd at once, the only KO this engine has
  "setScreenKOEnabled": {"code": "null", "returns": "object"}
}

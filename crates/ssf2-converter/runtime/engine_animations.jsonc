// what the source's engine does in its own states, as this engine's animations: stats an
// animation states, code its first frame runs, and points it carries. keyed by this engine's
// animation names (the ones the conversion writes); an animation the fighter has none of is
// skipped. `self` is the fighter, as in any keyframe of its entity.
{
  "stats": {
    // the source steers an air dodge (its engine lets the dodge drift under the held direction)
    "airdodge": "allowMovement: true",
    // the source holds a revived fighter where it appears (the code below lets it go)
    "revival": "gravityMultiplier: 0"
  },
  // `code` is the lines an animation's first frame runs; `functions` are written into the
  // fighter's script for the ones that code names
  "code": {
    // the source plays a jump's `backflip` section when the jump starts under the direction the
    // fighter faces away from, and shows its fall once any jump starts coming down (the jump's
    // own frames stop at the top)
    "jump_in": [
      "if ((self.isFacingRight() && self.getHeldControls().LEFT) || (!self.isFacingRight() && self.getHeldControls().RIGHT)) self.playAnimation(\"jump_back\");",
      "self.removeTimer(jumpTimer);",
      "jumpTimer = self.addTimer(1, -1, fallAtJumpTop, { persistent: true });"
    ],
    "jump_midair": [
      "self.removeTimer(jumpTimer);",
      "jumpTimer = self.addTimer(1, -1, fallAtJumpTop, { persistent: true });"
    ],
    // a revived fighter appears 30 of the source's pixels above where it is revived and settles
    // there over its first second, then waits: from then, any held control lets it go, and it goes
    // by itself after five seconds (the source's 150 frames)
    "revival": [
      "revivedAt = self.getY();",
      "revivalFrames = 0;",
      "self.setY(revivedAt - 30 * PeptideRuntime.data.units.size);",
      "self.setXVelocity(0);",
      "self.setYVelocity(0);",
      "self.removeTimer(revivalTimer);",
      "revivalTimer = self.addTimer(1, -1, holdRevived, { persistent: true });"
    ]
  },
  // a watch the listed animations start on their first frame (after their own `code`), when the
  // fighter has the animation it `needs`
  "watches": {
    // the source's air dodge: on a fresh shield press in the air, out of a jump or a fall, it plays
    // its own clip where it is, keeping its momentum (measured: the source moves no distance on a
    // neutral dodge); this engine's airdash, which blinks across the stage, is switched off in the
    // fighter's stats
    "airdodge": {
      "animations": ["jump_in", "jump_back", "jump_loop", "jump_out", "jump_midair", "jump_midair_back", "fall_in", "fall_loop"],
      "needs": "airdodge",
      "start": [
        "self.removeTimer(dodgeTimer);",
        "dodgeTimer = self.addTimer(1, -1, dodgeOnShield, { persistent: true });"
      ]
    }
  },
  "functions": {
    "fallAtJumpTop": [
      "var jumpTimer = -1;",
      "function fallAtJumpTop() {",
      "\tvar a = self.getAnimation();",
      "\tvar jumping = a == \"jump_in\" || a == \"jump_loop\" || a == \"jump_out\" || a == \"jump_back\" || a == \"jump_midair\" || a == \"jump_midair_back\";",
      "\tif (jumping && self.getYVelocity() < 0) return;",
      "\tself.removeTimer(jumpTimer);",
      "\tjumpTimer = -1;",
      "\tif (jumping) self.toState(CState.FALL);",
      "}"
    ],
    "holdRevived": [
      "var revivedAt = 0.0;",
      "var revivalFrames = 0;",
      "var revivalTimer = -1;",
      "function holdRevived() {",
      "\tif (!self.inState(CState.REVIVAL)) {",
      "\t\tself.removeTimer(revivalTimer);",
      "\t\trevivalTimer = -1;",
      "\t\treturn;",
      "\t}",
      "\trevivalFrames++;",
      "\tself.setYVelocity(0);",
      "\tvar s = PeptideRuntime.data.units.size;",
      "\tif (revivalFrames <= 60) self.setY(revivedAt - 30 * s + revivalFrames * 0.5 * s);",
      "\tvar c = self.getHeldControls();",
      "\tif (revivalFrames >= 300 || (revivalFrames > 60 && (c.LEFT || c.RIGHT || c.UP || c.DOWN || c.ATTACK || c.SPECIAL || c.JUMP || c.SHIELD || c.GRAB))) self.toState(CState.FALL);",
      "}"
    ],
    "dodgeOnShield": [
      "var dodgeTimer = -1;",
      "function dodgeOnShield() {",
      "\tvar airborne = self.inState(CState.JUMP_IN) || self.inState(CState.JUMP_LOOP) || self.inState(CState.JUMP_OUT) || self.inState(CState.JUMP_MIDAIR) || self.inState(CState.FALL);",
      "\tvar p = self.getPressedControls();",
      "\tif (airborne && (p == null || p.SHIELD != true || self.isOnFloor())) return;",
      "\tself.removeTimer(dodgeTimer);",
      "\tdodgeTimer = -1;",
      "\tif (!airborne) return;",
      "\tself.toState(CState.FALL_SPECIAL);",
      "\tself.playAnimation(\"airdodge\");",
      "}"
    ]
  },
  // points an animation carries for the whole of its length, by layer name
  "points": {
    // the source hangs a fighter with the ledge at its origin, through every ledge action
    "ledgeholdpoint0": {
      "x": 0, "y": 0,
      "animations": ["ledge_in", "ledge_loop", "ledge_climb_in", "ledge_climb", "ledge_roll_in", "ledge_roll",
                     "ledge_attack_in", "ledge_attack", "ledge_jump_in", "ledge_jump"]
    }
  }
}

    "ITEM_WIND": "\"itemWind\"",
    "ITEM_TOUCH": "\"itemTouch\"",
    "ITEM_DESTROYED": "\"itemDestroyed\"",
    "ITEM_PICKUP": "\"itemPickup\"",
    "ITEM_TOSSED": "\"itemTossed\"",

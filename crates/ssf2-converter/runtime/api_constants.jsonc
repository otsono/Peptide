    "CHAR_GRABBED": "\"charGrabbed\"",
    "CHAR_GRAB": "\"charGrab\"",
    "CHAR_LEDGE_GRAB": "\"charLedgeGrab\"",
    "CHAR_HURT": "\"charHurt\"",
    "CHAR_DAMAGE": "\"charDamage\"",
    "DAMAGE_CHANGED": "\"damageChanged\"",
    "CHAR_WIND": "\"charWind\"",
    "CHAR_SELF_DESTRUCT": "\"charSelfDestruct\"",
    "CHAR_TRANSFORM": "\"charTransform\"",
    "CHAR_KO_DEATH": "\"charKODeath\"",

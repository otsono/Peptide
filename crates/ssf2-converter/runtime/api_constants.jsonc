// The constant tables content reads its engine's values from: event names, state numbers, item
// frequencies. The values are the ones content compares against. A read of one is written as its
// value at conversion; nothing of them is in a converted script.
{
  // the events an object raises, by the name a listener is added under
  "PeptideEvent": {
    "GAME_TICK_START": "\"gameTickStart\"",
    "GAME_TICK_END": "\"gameTickEnd\"",
    "GAME_ITEM_CREATED": "\"gameItemCreated\"",

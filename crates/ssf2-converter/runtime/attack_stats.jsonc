// an attack's stats as this engine's own animation stats, settled at conversion. an attack's
// declared stats go into its animation's AnimationStats; a write its code makes while it plays
// (`updateAttackStats({...})`) becomes `updateAnimationStats({...})` on the spot. a stat with no
// row here stays with the runtime.
//
// each row: the engine field it sets and how its value converts.
//   bool      the value, as true or false
//   not       the value turned over
//   speed     the value in this engine's speed units
//   accel     the value in this engine's acceleration units
//   less      a slowdown the source states as a negative amount a frame, as this engine's
//             friction (a positive one keeps a share of the speed instead: its `code` below)
//   cap       a speed cap in this engine's speed units, or off (-1) when the source's is negative
//   zero      0
//   unset     -1, which the engine reads as the fighter's own value
//   value     the row's `value`, as written (and its `off` when a value the code works out as it
//             plays is not true)
// `when`: `negative` or `positive` limits a row to values of that sign; `true` or `false` to a
// value that is so.
// `with`: the row holds only when that other stat is stated true alongside.
// `rank`: which of two stats setting one field wins, whatever order the source wrote them in:
// `over` holds against the others, `under` never replaces one, `least` gives way to anything
// `clamp`: the fighter's fall speed is held to the new value on the spot too. the source clamps
// the fall after gravity every frame; this engine only stops gravity adding past its terminal
// velocity, so a speed written above it would stay (ganondorf's dive sets its speed and then
// its ease, and fell 1.5 of his gravity too far a frame)
{
  "stats": {
    "xSpeedDecay":            [{ "field": "friction", "as": "less", "when": "negative" }],
    "xSpeedDecayAir":         [{ "field": "aerialFriction", "as": "less", "when": "negative" }],
    "xSpeedCap":              [{ "field": "groundSpeedCap", "as": "speed" }],
    "xSpeedAccel":            [{ "field": "groundSpeedAcceleration", "as": "accel" }],
    "xSpeedAccelAir":         [{ "field": "aerialSpeedAcceleration", "as": "accel" }],
    // a cap on the fall while it is in force (0 hangs in the air: sora's side special), off when
    // negative; the engine holds it through its own physics, after timers
    "air_ease":               [{ "field": "terminalVelocity", "as": "cap", "clamp": true }],
    "cancelWhenAirborne":     [{ "field": "leaveGroundCancel", "as": "bool" }],
    "canFallOff":             [{ "field": "slideOff", "as": "bool" }],
    "allowJump":              [{ "field": "allowJump", "as": "bool" }],
    "jumpCancelAttack":       [{ "field": "allowJump", "as": "bool" }],
    "disableJump":            [{ "field": "allowJump", "as": "not" }],
    "allowTurn":              [{ "field": "allowTurn", "as": "bool" }],
    "allowFastFall":          [{ "field": "allowFastFall", "as": "bool" }],
    "allowFullInterrupt":     [{ "field": "interruptible", "as": "bool" }],
    "doubleJumpCancelAttack": [{ "field": "doubleJumpCancel", "as": "bool" }],
    // steering: in the air by `allowControl`, and on the floor only when `allowControlGround`
    // also allows it (no ground acceleration, else the fighter's own)
    "allowControl":           [{ "field": "allowMovement", "as": "bool" }],
    "allowControlGround":     [{ "field": "groundSpeedAcceleration", "as": "zero", "when": "false", "rank": "over" },
                               { "field": "groundSpeedAcceleration", "as": "unset", "when": "true", "rank": "under" }],
    // what it is immune to while it plays: invincible over super armor, and grabbable as well when
    // it says so
    // (one turned off takes it off, unless another stated with it holds)
    "invincible":             [{ "field": "bodyStatus", "as": "value", "value": "BodyStatus.INVINCIBLE", "off": "BodyStatus.NONE", "when": "true" },
                               { "field": "bodyStatus", "as": "value", "value": "BodyStatus.NONE", "when": "false", "rank": "least" }],
    "forceGrabbable":         [{ "field": "bodyStatus", "as": "value", "value": "BodyStatus.INVINCIBLE_GRABBABLE", "when": "true", "with": "invincible", "rank": "over" }],
    "superArmor":             [{ "field": "bodyStatus", "as": "value", "value": "BodyStatus.SUPER_ARMOR", "off": "BodyStatus.NONE", "when": "true", "rank": "under" },
                               { "field": "bodyStatus", "as": "value", "value": "BodyStatus.NONE", "when": "false", "rank": "least" }]
    // resetMovement has no row here but a first-frame one below: the engine's speed conservation
    // sets a standstill as exactly 0, where the source's rest in the air is a speed a step of
    // gravity ahead here (a y speed is), and the fighter is put back at the height it started from
    // (peach's parasol, zeroed by the engine, rose 7 higher and landed 3 frames late)
  },
  // what an attack's declared stats have each of its animations do on their first frame (`when`
  // as above; `unless` names a stat that, stated false, leaves it out; `first` runs it on the
  // attack's own animation only). `code` is written into the fighter's script once, for any
  // attack that takes the row (the same code under two rows once); `call` is the lines its first
  // frame runs, most often setting the script's values for the attack and starting a timer on
  // the script's function (a line two rows share runs once): `{v}` is the stat's value, `{name}`
  // another stat the attack declares (0 when none, `{name|d}` d). `self` is the fighter,
  // `PeptideRuntime.object` the source's object for it
  "code": {
    "chargetime_max": { "unless": "useChargeBar",
      "call": [
        "chargeMost = {v};",
        "chargeInAir = {chargeInAir|1};",
        "chargeIn = self.getAnimation();",
        "self.removeTimer(chargeTimer);",
        "chargeTimer = self.addTimer(1, -1, chargeAttack, { persistent: true });"
      ],
      "code": [
        "// a charge the source's engine runs: an attack that declares a charge time and does not say",
        "// it charges itself (`useChargeBar: 0`) is charged while its clip is in \"charging\". held, it",
        "// stays (the clip loops itself); let go, or in the air when it does not charge there, it",
        "// plays \"attack\"; charged to its time, it plays \"finishedcharge\", and from there a release",
        "// plays \"attack\". how long it charged is the attack's `chargetime`, for the move's own code.",
        "// its animations start the timer; it stops once another animation plays",
        "var chargeMost = 0.0;",
        "var chargeInAir = 1;",
        "var charged = 0.0;",
        "var chargeIn = null;",
        "var chargeTimer = -1;",
        "function chargeAttack() {",
        "\tif (self.getAnimation() != chargeIn) {",
        "\t\tself.removeTimer(chargeTimer);",
        "\t\tchargeTimer = -1;",
        "\t\tcharged = 0;",
        "\t\treturn;",
        "\t}",
        "\tvar clip = PeptideRuntime.shownClip();",
        "\tvar at = PeptideRuntime.xframeOf(clip);",
        "\tif (at != \"charging\" && at != \"finishedcharge\") {",
        "\t\tcharged = 0;",
        "\t\treturn;",
        "\t}",
        "\tvar c = self.getHeldControls();",
        "\tvar held = c != null && AS3.truthy(c.SPECIAL);",
        "\tvar go = null;",
        "\tif (at == \"charging\") {",
        "\t\tcharged += 0.5;",
        "\t\tif (!held || (!self.isOnFloor() && chargeInAir == 0)) go = \"attack\";",
        "\t\telse if (charged >= chargeMost) go = \"finishedcharge\";",
        "\t} else if (!held) go = \"attack\";",
        "\tif (go == null) return;",
        "\tAttacks.update(PeptideRuntime.object, { chargetime: charged });",
        "\tPeptideRuntime.setXframe(clip, go);",
        "\tcharged = 0;",
        "\tclip.gotoAndPlay(go);",
        "}"
      ] },
    // an attack that says it resets its movement starts from a standstill (mario's up special took
    // seven frames of fall speed into its climb without it)
    "resetMovement": { "when": "true", "first": true, "call": ["self.setXVelocity(0);", "self.setYVelocity(0);"] },
    "flip": { "when": "true", "first": true, "call": "turnAround();",
      "code": [
        "// an attack that says it flips turns its fighter around as it begins (marth's back air). this",
        "// engine turns no one in a throw: a throw that flips is drawn and launched already turned",
        "// (entity_gen.rs `turned_throws`), and the thrower turns once it is over",
        "function turnAround() {",
        "\tif (self.inState(CState.THROW_UP) || self.inState(CState.THROW_DOWN) || self.inState(CState.THROW_FORWARD) || self.inState(CState.THROW_BACK) || self.inState(CState.GRAB_HOLD)) PeptideRuntime.object.__turnAtEnd = true;",
        "\telse if (self.isFacingRight()) self.faceLeft();",
        "\telse self.faceRight();",
        "}"
      ] },
    "xSpeedDecay": { "when": "positive",
      "call": [
        "keptOnFloor = {xSpeedDecay|0};",
        "keptInAir = {xSpeedDecayAir|0};",
        "keptIn = self.getAnimation();",
        "self.removeTimer(keepTimer);",
        "keepTimer = self.addTimer(1, -1, keepSpeed, { persistent: true });",
        "self.updateAnimationStats({ friction: 0 });"
      ],
      "code": [
        "// a positive slowdown keeps a share of the speed each source frame (jigglypuff's side special",
        "// keeps 0.8), on the floor or in the air: the engine's friction off for the animation, and the",
        "// share's square root kept each engine frame. its animations start the timer; it stops once",
        "// another animation plays. a share of 0 keeps nothing (a negative slowdown is the engine's",
        "// friction, set in the animation's stats)",
        "var keptOnFloor = 0.0;",
        "var keptInAir = 0.0;",
        "var keptIn = null;",
        "var keepTimer = -1;",
        "function keepSpeed() {",
        "\tif (self.getAnimation() != keptIn) {",
        "\t\tself.removeTimer(keepTimer);",
        "\t\tkeepTimer = -1;",
        "\t\treturn;",
        "\t}",
        "\tvar share = self.isOnFloor() ? keptOnFloor : keptInAir;",
        "\tif (share > 0) self.setXVelocity(self.getXVelocity() * Math.sqrt(share));",
        "}"
      ] },
    "xSpeedDecayAir": { "when": "positive", "same_as": "xSpeedDecay",
      "call": [
        "keptOnFloor = {xSpeedDecay|0};",
        "keptInAir = {xSpeedDecayAir|0};",
        "keptIn = self.getAnimation();",
        "self.removeTimer(keepTimer);",
        "keepTimer = self.addTimer(1, -1, keepSpeed, { persistent: true });",
        "self.updateAnimationStats({ aerialFriction: 0 });"
      ] },
    "combo_max": { "when": "positive",
      "call": [
        "comboChargeTime = {chargetime_max|0};",
        "comboHoldRepeat = {holdRepeat|0};",
        "comboIn = self.getAnimation();",
        "self.removeTimer(comboTimer);",
        "comboTimer = self.addTimer(1, -1, watchCombo, { persistent: true });"
      ],
      "code": [
        "// the source's combo protocol, which its engine runs and the clip only answers: while the",
        "// attack plays, its button pressed (or held, for one that repeats on a hold) tells the clip to",
        "// go on, through the two fields the fighter keeps (handled, continuePlaying); one that also",
        "// charges goes on only once it is attacking (its `xframe` at \"attack\"). its animations start",
        "// the timer; it stops once another animation plays",
        "var comboChargeTime = 0.0;",
        "var comboHoldRepeat = 0;",
        "var comboIn = null;",
        "var comboTimer = -1;",
        "function watchCombo() {",
        "\tif (self.getAnimation() != comboIn) {",
        "\t\tself.removeTimer(comboTimer);",
        "\t\tcomboTimer = -1;",
        "\t\treturn;",
        "\t}",
        "\tif (comboChargeTime > 0) {",
        "\t\tvar at = PeptideRuntime.xframeOf(PeptideRuntime.shownClip());",
        "\t\tif (at != null && at != \"attack\") return;",
        "\t}",
        "\tvar me = PeptideRuntime.object;",
        "\tif (me.handled != false) return;",
        "\tvar special = self.inState(CState.SPECIAL_NEUTRAL) || self.inState(CState.SPECIAL_SIDE) || self.inState(CState.SPECIAL_UP) || self.inState(CState.SPECIAL_DOWN);",
        "\tvar pressed = self.getPressedControls();",
        "\tvar held = self.getHeldControls();",
        "\tvar press = special ? pressed.SPECIAL : (pressed.ATTACK || pressed.GRAB);",
        "\tvar hold = special ? held.SPECIAL : (held.ATTACK || held.GRAB);",
        "\tif (AS3.truthy(press) || (comboHoldRepeat != 0 && AS3.truthy(hold))) {",
        "\t\tme.continuePlaying = true;",
        "\t\tme.handled = true;",
        "\t}",
        "}"
      ] }
  },
  // what an attack that states nothing has: it goes off a floor's edge and ends once airborne
  "defaults": { "leaveGroundCancel": true, "slideOff": true },
  // stats a landing's own animation takes that an attack's would not: a landing animation is only
  // ever on the floor, so steering there is off when the floor's steering is
  "landing": {
    "allowControl":           [{ "field": "allowMovement", "as": "bool" }],
    "allowControlGround":     [{ "field": "allowMovement", "as": "bool", "when": "false", "rank": "over" }]
  },
  // the source's calls that land a fighter in its landing state: a floor-touch listener that is
  // one of them is the engine's own landing (`LandType.NORMAL`) into that animation
  "landings": { "toLand": "land_light", "toHeavyLand": "land_heavy" }
}

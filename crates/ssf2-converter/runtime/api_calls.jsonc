// content's API calls written as the Fraymakers calls they are, at conversion.
//
// a call to a listed member becomes its template, in place: `{eng}` is the engine object of the
// object it is asked of, `{recv}` that object itself (for a helper that keeps state on it), `{0}`, `{1}` ... its arguments, `{size}` and `{speed}` the units source
// numbers are scaled by. nothing is left to answer it while the match runs. a member content
// defines itself keeps its own; a member listed here that content hands around as a value (a
// listener) is still answered by the runtime until it moves too.
{
  // where it is and how it moves
  "getX": "Objects.readX({eng}) / {size}",
  "getSmashTimer": "Objects.smashTimer({eng})",
  "getY": "Objects.readY({eng}) / {size}",
  "setX": "{eng}.setX(AS3.num({0}) * {size})",
  "setY": "{eng}.setY(AS3.num({0}) * {size})",
  "getXSpeed": "Objects.slideHeld({eng}) / {speed}",
  "getYSpeed": "({eng}.getYSpeed() - Objects.fallHeld({eng})) / {speed}",
  "isFacingRight": "Objects.facingRight({eng})",
  "faceRight": "Objects.face({eng}, true)",
  "faceLeft": "Objects.face({eng}, false)",
  "isOnGround": "{eng}.isOnFloor()",
  "unattachFromFloor": "{eng}.unattachFromFloor()",
  "getRotation": "{eng}.getRotation()",
  "setRotation": "{eng}.setRotation(AS3.num({0}))",
  "resetRotation": "{eng}.resetRotation()",
  "getXScale": "{eng}.getScaleX()",
  "getYScale": "{eng}.getScaleY()",
  "getSizeRatio": "{eng}.getSizeMultiplier()",
  "setVisibility": "{eng}.setVisible(AS3.truthy({0}))",
  "setAlpha": "PeptideGameObject.setAlpha({recv}, {0})",
  "getAlpha": "PeptideGameObject.getAlpha({recv})",
  // damage, hits and body status
  "getDamage": "{eng}.getDamage()",
  "setDamage": "{eng}.setDamage({0})",
  "dealDamage": "{eng}.addDamage(AS3.num({0}))",
  "refreshAttackID": "PeptideGameObject.reactivate({recv})",
  "forceHitStun": "{eng}.forceStartHitstop(Std.int(Math.ceil(AS3.num({0}))) * 2)",
  "getInvincibility": "{eng}.hasBodyStatus(BodyStatus.INVINCIBLE)",
  "getIntangibility": "{eng}.hasBodyStatus(BodyStatus.INTANGIBLE)",
  // state changes
  "toLand": "{eng}.toState(CState.LAND)",
  "toHeavyLand": "{eng}.toState(CState.LAND, \"land_heavy\")",
  "goHelpless": "{eng}.toState(CState.FALL_SPECIAL)",
  "toFlying": "{eng}.toState(CState.HURT_HEAVY)",
  "toCrashLand": "{eng}.toState(CState.CRASH_BOUNCE)",
  "toBounce": "{eng}.toState(CState.CRASH_BOUNCE)",
  "toJump": "{eng}.toState(CState.JUMP_SQUAT)",
  "toDodgeRoll": "{eng}.toState(CState.ROLL)",
  // jumps, grabs, ledges
  "resetJumps": "{eng}.setDoubleJumpCount(0)",
  // a projectile's own physics, switched by whoever holds it
  "modifyGravity": "PeptideProjectile.modifyGravity({recv}, {0})",
  "modifyContinueOnGround": "PeptideProjectile.modifyContinueOnGround({recv}, {0})",
  "modifyContinueOnCrash": "PeptideProjectile.modifyContinueOnCrash({recv}, {0})",
  "setInvisibilityTimer": "PeptideRuntime.gap(\"setInvisibilityTimer: a fighter turned invisible for a while\")",
  "getMatchStatistics": "PeptideAPI.matchStatistics({recv})",
  // every jump in the air used
  "maxOutJumps": "{eng}.setDoubleJumpCount({eng}.getCharacterStat(\"doubleJumpSpeeds\").length)",
  "getMidairJumpCount": "{eng}.getDoubleJumpCount()",
  "releaseOpponent": "{eng}.releaseAllCharacters()",
  "grabReleaseOpponent": "{eng}.releaseAllCharacters()",
  "releaseLedge": "{eng}.releaseLedge()",
  // who it is
  "getCostume": "{eng}.getCostumeIndex()",
  "getLives": "{eng}.getLives()",
  "getUID": "{eng}.getUid()",
  "getID": "{eng}.getUid()",
  "getTeamID": "{eng}.getTeam()",
  // what this engine has no counterpart for, answered as a match with none of it would
  "getMetalStatus": "false",
  "isForcedCrash": "false",
  "isCPU": "false",
  "cpuLevel": "0",
  "cpuAction": "0",
  "cpuForcedAction": "-1",
  "cpuTarget": "null",
  "getShieldPower": "1",
  "tetherCount": "0",
  "isStandby": "false",
  "getStandby": "false",
  "inFinalSmash": "false",
  "finalCutscene": "null",
  "copyPower": "null",
  "getHealthBox": "null",
  "getBounceSpeed": "0",
  "nearTopLeft": "false",
  "nearTopRight": "false",
  "nearBottomLeft": "false",
  "nearBottomRight": "false",
  // the behaviour helpers a call hands its object to: events, timers, attacks, projectiles, effects, sound
  "addEventListener": "Events.add({recv}, {0}, {1}, {2})",
  "removeEventListener": "Events.remove({recv}, {0}, {1})",
  "hasEventListener": "Events.has({recv}, {0}, {1})",
  "addTimer": "Timers.create({recv}, {0}, {1}, {2}, {3})",
  "removeTimer": "Timers.destroy({recv}, {0})",
  "getAnimationStat": "Attacks.stat({recv}, {0})",
  "updateAnimationStats": "Attacks.update({recv}, {0})",
  "getHitboxStat": "Attacks.boxStat({recv}, {0}, {1})",
  "updateHitboxStats": "Attacks.updateBox({recv}, {0}, {1})",
  "getProjectileStat": "Projectiles.stat({recv}, {0})",
  "getEnemyStat": "{recv}.__stats == null ? null : Projectiles.stat({recv}, {0})",
  "createProjectile": "Projectiles.fire({recv}, {0}, {1}, {2}, {3}, {4})",
  "createVfx": "Effects.attach({recv}, {0}, {1})",
  "createVfxOverlay": "Effects.attach({recv}, {0}, {1})",
  "playSound": "Sounds.play({recv}, {0})",
  "stopSound": "Sounds.stop({0})",
  "shake": "Effects.shake({0})",
  "setColorFilters": "Visuals.filters({recv}, {0})",
  "setYSpeed": "{eng}.setYSpeed(Objects.ySpeedTo({eng}, AS3.num({0}) * {speed}))",
  "bringBehind": "Stage.order({recv}, {0}, false)",
  "bringInFront": "Stage.order({recv}, {0}, true)",
  "swapDepths": "Stage.layer.swapChildren({recv}.__mc, {0} == null ? null : ({0}.__fm != null ? {0}.__mc : {0}))",
  // the object itself: owner, holder, stage, camera, floors
  "getOwner": "Objects.view({eng}.getOwner())",
  "getHolder": "Objects.view({eng}.exports.__holder)",
  "getLinkageID": "{eng}.exports == null ? null : {eng}.exports.__linkageId",
  "getUses": "{eng}.exports.__uses == null ? 0 : {eng}.exports.__uses",
  "isZDropped": "{eng}.exports.__zDropped == true",
  "isDisposed": "{recv} == null || {eng} == null || {eng}.isDisposed()",
  "isEqual": "{0} == {recv}",
  "isFacingLeft": "!{eng}.isFacingRight()",
  "isIntangible": "{eng}.hasBodyStatus(BodyStatus.INTANGIBLE)",
  "isReversed": "{eng}.isReversed != null && {eng}.isReversed()",
  "inHitStun": "{eng}.getHitstop() > 0",
  "getScale": "Point.create({eng}.getScaleX(), {eng}.getScaleY())",
  "getAnimation": "{recv}.__mc != null ? {recv}.__mc.currentLabel : {eng}.getAnimation()",
  "stanceClip": "PeptideRuntime.stanceOf({recv}.__mc)",
  "getCurrentPlatform": "Platforms.view({eng}.getCurrentFloor())",
  "forceOnGround": "PeptideGameObject.attachToFloor({recv})",
  "getNoDropThrough": "PeptidePlatform.structureStat({recv}, \"dropThrough\") != true",
  "setNoDropThrough": "PeptidePlatform.structureStats({recv}, { dropThrough: !AS3.truthy({0}) })",
  "setConserveDownwardMomentum": "PeptidePlatform.structureStats({recv}, { conserveDownwardMomentum: AS3.truthy({0}) })",
  "setConserveHorizontalMomentum": "PeptidePlatform.structureStats({recv}, { conserveHorizontalMomentum: AS3.truthy({0}) })",
  "setConserveUpwardMomentum": "PeptidePlatform.structureStats({recv}, { conserveUpwardMomentum: AS3.truthy({0}) })",
  "getFallthrough": "{recv}.__fallthrough",
  "addToCamera": "match.getCamera().addTarget({eng})",
  "camFocus": "match.getCamera().addTimedTarget({eng}, AS3.num({0}) * 2)",
  "camUnfocus": "match.getCamera().deleteTimedTarget({eng})",
  "getCameraParameter": "{recv}.__params.get(AS3.str({0}))",
  "getStage": "PeptideAPI.getStage()",
  // the stage's planes, from any object but a stage (`by_kind` below): the layer the fighters
  // are drawn in
  "getBackground": "Stage.layer",
  "getForeground": "Stage.layer",
  "getMidground": "Stage.layer",
  "getLedges": "Stage.ledges()",
  "getHomingTarget": "PeptideGameObject.getNearest({recv}, \"character\")",
  "applyKnockback": "PeptideGameObject.applyKnockbackSpeed({recv}, PeptideAPI.knockbackVelocityOf({0}), {1})",
  "applyPaletteToEffect": "PeptideGameObject.applyPalette({recv}, {0})",
  "endControl": "{recv}.__stats.set(\"controlDirection\", -1)",
  "setFrameInterrupt": "{recv}.__frameInterrupt = {0}",
  "setPaletteData": "{recv}.__palette = {0}",
  "sharedVar": "{recv}.__vars.get({0})",
  "setSharedVar": "{recv}.__vars.set({0}, {1})",
  "setInterruptible": "Common.setIASA(AS3.truthy({0}))",
  "toHold": "PeptideItem.toHeld({recv})",
  "getGameTimer": "PeptideAPI.getGameTimer()",
  "getCurrentTime": "Std.int(match.getElapsedFrames() / 2)",
  "getExecTime": "Attacks.execTime({recv})",
  // what this engine has no way to do: reported where the source does it, or nothing
  "darken": "PeptideCamera.darken({recv}, true)",
  "lighten": "PeptideCamera.darken({recv}, false)",
  "dispose": "null",
  "endFinalCutscene": "null",
  "killDarkener": "null",
  "lightFlash": "null",
  "pickupItem": "PeptideRuntime.gap(\"pickupItem: picking up an item off the stage\")",
  "playCpuInputs": "null",
  "removeStageFocus": "null",
  "resetCpuInputs": "null",
  "rocketFighter": "PeptideCharacter.rocket({recv}, {0}, {1}, {2}, {3})",
  "setCamBoxSize": "null",
  // a surface's own friction (an icy floor): this engine's surfaces have none to set
  "setAccelFriction": "PeptideRuntime.gap(\"setAccelFriction: a surface's own friction\")",
  "setDecelFriction": "PeptideRuntime.gap(\"setDecelFriction: a surface's own friction\")",
  "setCpuQueue": "null",
  "setFinalMeter": "null",
  "setMode": "null",
  "setStageFocus": "PeptideRuntime.gap(\"camera stage focus\")",
  "setTeamID": "PeptideRuntime.gap(\"setTeamID: changing a fighter's team\")",
  "startFinalCutscene": "PeptideRuntime.gap(\"startFinalCutscene: a final smash cutscene\")",
  "swapFighter": "PeptideRuntime.gap(\"swapFighter: turning into another fighter\")",
  "throbDamage": "null",
  "toFinalForm": "PeptideRuntime.gap(\"toFinalForm: a final form\")",
  // a fighter's own, and the rest a game object answers
  "flip": "Objects.face({eng}, !Objects.facingRight({eng}))",
  "flipX": "{eng}.flipX({0})",
  "resetKnockback": "{eng}.setXKnockback(0); {eng}.setYKnockback(0)",
  "resetMovement": "{eng}.setXSpeed(0); {eng}.setYSpeed(Objects.fallHeld({eng}))",
  "takeDamage": "PeptideGameObject.takeDamage({recv}, {0}, {1})",
  "getHitBox": "PeptideRuntime.gap(\"getHitBox: a named box's rectangle\")",
  "removeFromCamera": "{eng}.getType() == EntityType.CHARACTER ? null : match.getCamera().deleteTarget({eng})",
  "setScale": "{eng}.setScaleX(AS3.num({0})); {eng}.setScaleY(AS3.num({1}))",
  "setPosition": "{eng}.setX(AS3.num({0}) * {size}); {eng}.setY(AS3.num({1}) * {size})",
  "setState": "States.enter({eng}, {0})",
  "getState": "States.of({eng})",
  "endAnimation": "Fighters.endAnimation({recv})",
  "updateCharacterStats": "Fighters.updateStats({recv}, {0})",
  "getControls": "Fighters.controls({recv}, {0})",
  "playAttackSfx": "Sounds.attack({recv}, \"attackSound\", {0})",
  "playVoiceSfx": "Sounds.attack({recv}, \"attackVoice\", {0})",
  "getItem": "Items.held({recv})",
  "makePickup": "Items.generate({recv}, {0})",
  "makeFighterPickup": "Items.generate({recv}, {0})",
  "throwPickup": "Items.toss({recv}, {0})",
  "removeItem": "Items.remove({recv})",
  "dropItem": "Items.drop({recv}, {0})",
  "allowAttack": "Actions.set({recv}, {0}, {1}, {2})",
  "attackAllowed": "Actions.enabled({recv}, {0})",
  "getGrabbedOpponents": "Objects.views({eng}.getAllGrabbedFoes())",
  "getGrabbedOpponent": "Objects.view({eng}.getGrabbedFoe())",
  "setIntangibility": "{eng}.updateAnimationStats({ bodyStatus: AS3.truthy({0}) ? BodyStatus.INTANGIBLE : BodyStatus.NONE })",
  "setInvincibility": "{eng}.updateAnimationStats({ bodyStatus: AS3.truthy({0}) ? BodyStatus.INVINCIBLE : BodyStatus.NONE })",
  "recover": "Fighters.recover({eng}, {0})",
  "getCurrentFrame": "{recv}.__mc != null ? {recv}.__mc.currentLabel : {eng}.getAnimation()",
  "getCurrentProjectile": "Fighters.lastProjectile({eng})",
  "setHurtInterrupt": "{recv}.__hurtInterrupt = {0}",
  "setCostume": "Fighters.setCostume({recv}, {0})",
  "setMetalStatus": "AS3.truthy({0}) ? PeptideRuntime.gap(\"setMetalStatus: a metal fighter\") : null",
  "copyHatClip": "Fighters.hat({recv})",
  "getLastUsed": "Fighters.lastUsed({recv}, {0})",
  "setLastUsed": "Fighters.setLastUsed({recv}, {0}, {1})",
  // a game object's own, on its class
  "applyKnockbackSpeed": "PeptideGameObject.applyKnockbackSpeed({recv}, {0}, {1})",
  "netXSpeed": "PeptideGameObject.netXSpeed({recv}, {0}, {1})",
  "netYSpeed": "PeptideGameObject.netYSpeed({recv}, {0}, {1})",
  "netSpeed": "PeptideGameObject.netSpeed({recv}, {0}, {1})",
  "attachToFloor": "PeptideGameObject.attachToFloor({recv})",
  "moveIfClear": "PeptideGameObject.moveIfClear({recv}, {0}, {1})",
  "makeOwnFloor": "PeptideGameObject.makeOwnFloor({recv}, {0}, {1}, {2}, {3}, {4})",
  "createSelfPlatformWithMC": "PeptideGameObject.makeOwnFloorOf({recv}, {0}, {1})",
  "dropOwnFloor": "PeptideGameObject.dropOwnFloor({recv})",
  "getNearestLedge": "PeptideGameObject.getNearestLedge({recv})",
  "getNearest": "PeptideGameObject.getNearest({recv}, {0}, {1}, {2})",
  "getNearestPath": "PeptideGameObject.getNearestPath({recv}, {0}, {1})",
  "homeTowardsTarget": "PeptideGameObject.homeTowardsTarget({recv}, {0}, {1})",
  "paletteData": "PeptideGameObject.paletteData({recv})",
  "applyPalette": "PeptideGameObject.applyPalette({recv}, {0})",
  "getHeight": "PeptideGameObject.getHeight({recv})",
  "getWidth": "PeptideGameObject.getWidth({recv})",
  "ownStats": "PeptideGameObject.ownStats({recv})",
  "getGameObjectStat": "PeptideGameObject.getGameObjectStat({recv}, {0})",
  "startAttack": "PeptideGameObject.startAttack({recv}, {0}, {1}, {2})",
  // a fighter's own, on its class
  "getCharacterStat": "PeptideCharacter.getCharacterStat({recv}, {0})",
  "swapDepthGrabbed": "PeptideCharacter.swapDepthGrabbed({recv}, {0})",
  "grabbedHurtFrame": "PeptideCharacter.grabbedHurtFrame({recv}, {0})",
  "initiateCrash": "{eng}.toState(CState.CRASH_BOUNCE); PeptideGameObject.attachToFloor({recv})",
  "ejectOpponent": "PeptideCharacter.ejectOpponent({recv})",
  "grabRelease": "PeptideCharacter.grabRelease({recv})",
  "grab": "PeptideCharacter.grab({recv}, {0}, {1}, {2}, {3})",
  "toGrabbed": "PeptideCharacter.toGrabbed({recv})",
  "toGrabbing": "PeptideCharacter.toGrabbing({recv}, {0})",
  "release": "PeptideCharacter.release({recv})",
  "getTeammates": "PeptideCharacter.getTeammates({recv})",
  // the camera's, on its class
  "addTarget": "PeptideCamera.addTarget({recv}, {0})",
  "deleteTarget": "PeptideCamera.deleteTarget({recv}, {0})",
  "addForcedTarget": "PeptideCamera.addForcedTarget({recv}, {0})",
  "deleteForcedTarget": "PeptideCamera.deleteForcedTarget({recv}, {0})",
  "addTimedTarget": "PeptideCamera.addTimedTarget({recv}, {0}, {1})",
  "deleteTimedCameraTarget": "PeptideCamera.deleteTimedCameraTarget({recv}, {0})",
  "removeTimedCameraTarget": "PeptideCamera.deleteTimedCameraTarget({recv}, {0})",
  // the HUD here is this engine's: what the source's does when a fighter is behind it is its own
  "addHUDDetection": "PeptideRuntime.gap(\"addHUDDetection: the HUD seeing what is behind it\")",
  "removeHUDDetection": "PeptideRuntime.gap(\"removeHUDDetection: the HUD seeing what is behind it\")",
  // a surface only some objects touch: this engine's surfaces keep a list of those they let through
  "setIgnoreObjectListInversed": "PeptideRuntime.gap(\"setIgnoreObjectListInversed: a surface only the listed objects touch\")",
  // the source's own game modes (all-star's rest stop, the warioware microgames' screen effect)
  "getSnapshot": "PeptideRuntime.gap(\"getSnapshot: the all-star mode's run so far\")",
  "resetTime": "PeptideRuntime.gap(\"resetTime: an all-star mode heal's timer\")",
  "warioWareEffect": "PeptideRuntime.gap(\"warioWareEffect: the microgames' screen effect\")",
  "addTimedTargetPoint": "PeptideCamera.addTimedTargetPoint({recv}, {0}, {1})",
  "deleteTimedTargetPoint": "PeptideCamera.deleteTimedTargetPoint({recv}, {0})",
  "updateCameraParameters": "PeptideCamera.updateCameraParameters({recv}, {0})",
  "getTopLeftPoint": "Point.create(match.getCamera().getX() / {size}, match.getCamera().getY() / {size})",
  "getMode": "match.getCamera().getMode()",
  // an item's own, on its class
  "activateItem": "{eng}.exports.__askActive = true",
  "deactivateItem": "{eng}.exports.__askActive = false",
  "getItemStat": "PeptideItem.getItemStat({recv}, {0})",
  "attack": "PeptideItem.attack({recv}, {0})",
  "toHeld": "PeptideItem.toHeld({recv})",
  "updateItemStats": "PeptideItem.updateItemStats({recv}, {0})",
  // a projectile's own, on its class
  "updateProjectileStats": "PeptideProjectile.updateProjectileStats({recv}, {0})",
  "exportStats": "PeptideProjectile.exportStats({recv})",
  "angleControl": "PeptideProjectile.angleControl({recv}, {0}, {1})",
  // the stage's, on its class
  "getCameraBounds": "PeptideStage.getCameraBounds({recv})",
  "getDeathBounds": "PeptideStage.getDeathBounds({recv})",
  "hudBack": "PeptideStage.hudBack({recv})",
  "hudFront": "PeptideStage.hudFront({recv})",
  "getCameraBackgrounds": "PeptideStage.getCameraBackgrounds({recv})",
  "getBoundsRect": "PeptideGameObject.boundsRect({recv}, 0, 0)",
  "getLightSourceMC": "PeptideStage.getLightSourceMC({recv})",
  "getWeatherMC": "PeptideStage.getWeatherMC({recv})",
  "getSpawnPositionMCs": "PeptideStage.getSpawnPositionMCs({recv})",
  "getSmashBallBounds": "PeptideStage.getSmashBallBounds({recv})",
  "getItemSpawnBoundsList": "PeptideStage.getItemSpawnBoundsList({recv})",
  "setStarKOEnabled": "PeptideRuntime.gap(\"setStarKOEnabled: the stage turning star KOs off\")",
  "updatePlayerSettings": "PeptideRuntime.gap(\"updatePlayerSettings: a player's respawn place\")",
  // an object drawn in front of the fighters, with the piece it names riding it
  "setForeground": "Stage.toFront({recv}, {0})",
  // a surface's, on its class
  "hitTestPoint": "PeptideCollisionBoundary.hitTestPoint({recv}, {0}, {1}, {2})",
  "hitTestRect": "PeptideCollisionBoundary.hitTestRect({recv}, {0}, {1})",
  // a platform's, on its class
  "setFallthrough": "PeptidePlatform.setFallthrough({recv}, {0})",
  "addMovement": "PeptidePlatform.addMovement({recv}, {0})",
  "setInterval": "PeptideStage.setInterval({recv}, {0}, {1})",
  "clearInterval": "PeptideStage.clearInterval({recv}, {0})",
  "addIgnoreObject": "PeptidePlatform.addIgnoreObject({recv}, {0})",
  "removeIgnoreObject": "PeptidePlatform.removeIgnoreObject({recv}, {0})",
  "getStartPosition": "PeptidePlatform.getStartPosition({recv})",
  // the final smash meter's, on its class
  "addToDamageMeter": "PeptideFinalSmashBar.addToDamageMeter({recv}, {0})",
  "removeFromDamageMeter": "PeptideFinalSmashBar.removeFromDamageMeter({recv}, {0})",
  "updateBar": "PeptideFinalSmashBar.updateBar({recv}, {0})",
  // a fighter's move helpers, on its class
  "jumpToContinue": "PeptideCharacterExt.jumpToContinue({recv}, {0})",
  "setLandingLag": "PeptideCharacterExt.setLandingLag({recv}, {0})",
  "addEffectToList": "PeptideCharacterExt.addEffectToList({recv}, {0})",
  "removeAllEffects": "PeptideCharacterExt.removeAllEffects({recv}, {0})",
  "clearEffectsOnStateChange": "PeptideCharacterExt.clearEffectsOnStateChange({recv}, {0})",
  "stopListening": "PeptideCharacterExt.stopListening({recv})",
  "pushEffectBehind": "PeptideCharacterExt.pushEffectBehind({recv}, {0})",
  "startAutolink": "PeptideCharacterExt.startAutolink({recv}, {0}, {1}, {2})",
  "stopAutolink": "PeptideCharacterExt.stopAutolink({recv})",
  "setAutolinkPoint": "PeptideCharacterExt.setAutolinkPoint({recv}, {0})",
  "setAutolinkRule": "PeptideCharacterExt.setAutolinkRule({recv}, {0})",
  // an enemy's own, on its class
  "updateEnemyStats": "PeptideEnemy.updateEnemyStats({recv}, {0})",
  // what any object does, by what it has (its engine object, its data)
  "getType": "{recv}.__type",
  "getMC": "{recv}.__mc",
  "setXSpeed": "{eng}.setXSpeed(Objects.slideTo({eng}, AS3.num({0}) * {speed}))",
  "playFrame": "PeptideGameObject.playFrame({recv}, {0})",
  "inState": "PeptideGameObject.inState({recv}, {0})",
  "toIdle": "Objects.toIdle({recv})",
  "toToss": "Objects.toToss({recv})",
  "destroy": "Objects.destroy({recv})",
  "setOwner": "{0} == null || {0}.__fm == null ? null : {eng}.setOwner({0}.__fm)",
  "breakTarget": "{eng}.isDisposed() ? null : {eng}.kill()",
  "initialize": "null",
  "update": "null",
  // a fighter's size: the source's items that grow and shrink one are its game's, so a fighter
  // here is always its own size (0)
  "getSizeStatus": "0",
  "toBarrel": "PeptideRuntime.gap(\"toBarrel: a fighter carried inside a barrel\")",
  // the rows one kind of object writes its own way, over the ones above
  "by_kind": {
    // a stage's planes are its own clips, as the kind running the code answers them
    // ...and a stage's places are its own space: the source's origin is where the engine's is not
    // (`DATA.origin`, in the source's units)
    "stage": {
      "hitTestPoint": "PeptideCollisionBoundary.hitTestPoint({recv}, AS3.num({0}) - PeptideRuntime.data.origin.x, AS3.num({1}) - PeptideRuntime.data.origin.y, {2})",
      "getBoundsRect": "PeptideGameObject.boundsRect({recv}, PeptideRuntime.data.origin.x, PeptideRuntime.data.origin.y)",
      "getBackground": "PeptideRuntime.kind.planeClip(\"background\")",
      "getForeground": "PeptideRuntime.kind.planeClip(\"foreground\")",
      "getMidground": "PeptideRuntime.kind.planeClip(\"midground\")",
      "getShadowMaskMC": "PeptideRuntime.kind.planeClip(\"shadowMask\")",
      "getX": "({eng}.getX() / {size} + PeptideRuntime.data.origin.x)",
      "getY": "({eng}.getY() / {size} + PeptideRuntime.data.origin.y)",
      "setX": "{eng}.setX((AS3.num({0}) - PeptideRuntime.data.origin.x) * {size})",
      "setY": "{eng}.setY((AS3.num({0}) - PeptideRuntime.data.origin.y) * {size})",
      "getLedges": "StageObjects.ledges()",
      "setScreenKOEnabled": "PeptideRuntime.gap(\"setScreenKOEnabled: the stage turning screen KOs off\")"
    },
    // a stage's object: places in the stage's space, as its stage's own code has them, and the
    // clip its animations show (its stance where its clip places one, else its clip)
    "object": {
      "hitTestPoint": "PeptideCollisionBoundary.hitTestPoint({recv}, AS3.num({0}) - PeptideRuntime.data.origin.x, AS3.num({1}) - PeptideRuntime.data.origin.y, {2})",
      "getShadowMaskMC": "Stage.planeOf({recv}, \"shadowMask\")",
      "getBoundsRect": "PeptideGameObject.boundsRect({recv}, PeptideRuntime.data.origin.x, PeptideRuntime.data.origin.y)",
      // a plane is the stage's, asked of it (the arwing flies the clip the stage's foreground holds)
      "getForeground": "Stage.planeOf({recv}, \"foreground\")",
      "getBackground": "Stage.planeOf({recv}, \"background\")",
      "getMidground": "Stage.planeOf({recv}, \"midground\")",
      "getX": "({eng}.getX() / {size} + PeptideRuntime.data.origin.x)",
      "getY": "({eng}.getY() / {size} + PeptideRuntime.data.origin.y)",
      "setX": "{eng}.setX((AS3.num({0}) - PeptideRuntime.data.origin.x) * {size})",
      "setY": "{eng}.setY((AS3.num({0}) - PeptideRuntime.data.origin.y) * {size})",
      "getLedges": "StageObjects.ledges()",
      "stanceClip": "Bodies.stance({recv})",
      "setScreenKOEnabled": "PeptideRuntime.gap(\"setScreenKOEnabled: the stage turning screen KOs off\")"
    },
    // a projectile a stage's object fires: places in the stage's space too
    "stage_projectile": {
      "getBoundsRect": "PeptideGameObject.boundsRect({recv}, PeptideRuntime.data.origin.x, PeptideRuntime.data.origin.y)",
      "getX": "({eng}.getX() / {size} + PeptideRuntime.data.origin.x)",
      "getY": "({eng}.getY() / {size} + PeptideRuntime.data.origin.y)",
      "setX": "{eng}.setX((AS3.num({0}) - PeptideRuntime.data.origin.x) * {size})",
      "setY": "{eng}.setY((AS3.num({0}) - PeptideRuntime.data.origin.y) * {size})"
    }
  }
}

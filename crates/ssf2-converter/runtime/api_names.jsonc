// the names the runtime answers to, for the ones content writes in SSF2's words.
//
// content calls its engine's API by SSF2's names (`SSF2API.getCharacter`, `me.stancePlayFrame`),
// and bundles SSF2's SDK classes (`SSF2Event`, `CState`) in its package. the converter renames
// those names to ours as it reads the package, before anything is compiled, so converted output
// carries this runtime's names and none of SSF2's own. a name not listed here keeps its name
// (the generic ones: getX, setXSpeed, addEventListener).
//
// renaming is uniform: every class reference, member access, definition, override and type check
// with a listed name is renamed, content's own included, so meaning is kept.
{
  // SSF2's API and SDK classes -> the runtime classes that answer for them: Peptide, then the
  // name without SSF2's prefix
  "classes": {
    "SSF2API": "PeptideAPI",
    "SSF2Asset": "PeptideAsset",
    "SSF2BaseAPIObject": "PeptideBaseAPIObject",
    "SSF2GameObject": "PeptideGameObject",
    "SSF2Character": "PeptideCharacter",
    "SSF2CharacterExt": "PeptideCharacterExt",
    "SSF2Projectile": "PeptideProjectile",
    "SSF2Item": "PeptideItem",
    "SSF2Enemy": "PeptideEnemy",
    "SSF2Target": "PeptideTarget",
    "SSF2Beacon": "PeptideBeacon",
    "SSF2Stage": "PeptideStage",
    "SSF2StageQuality": "PeptideStageQuality",
    "SSF2Camera": "PeptideCamera",
    "SSF2Platform": "PeptidePlatform",
    "SSF2CollisionBoundary": "PeptideCollisionBoundary",
    "SSF2GameTimer": "PeptideGameTimer",
    "SSF2CustomMatch": "PeptideCustomMatch",
    "SSF2CustomMenu": "PeptideCustomMenu",
    "SSF2CustomMode": "PeptideCustomMode",
    "SSF2Utils": "PeptideUtils",
    "SSF2Event": "PeptideEvent",
    "CState": "PeptideCState",
    "PState": "PeptidePState",
    "IState": "PeptideIState",
    "EState": "PeptideEState",
    "TState": "PeptideTState",
    "ControlBits": "PeptideControlBits",
    "ItemSettings": "PeptideItemSettings",
    "FrameTimer": "PeptideFrameTimer",
    "FinalSmashBar": "PeptideFinalSmashBar"
  },
  // SSF2's own verbs -> Fraymakers' name for the same thing where it has one, else the runtime's.
  // a verb Fraymakers already names the same way (getCharacterStat, updateProjectileStats) is not
  // listed: it keeps its name
  "members": {
    "stancePlayFrame": "playFrame",
    "getStanceMC": "stanceClip",
    "forceAttack": "startAttack",
    "endAttack": "endAnimation",
    "fireProjectile": "createProjectile",
    "attachEffect": "createVfx",
    "attachEffectOverlay": "createVfxOverlay",
    "playAttackSound": "playAttackSfx",
    "playVoiceSound": "playVoiceSfx",
    "getAttackStat": "getAnimationStat",
    "updateAttackStats": "updateAnimationStats",
    "getAttackBoxStat": "getHitboxStat",
    "updateAttackBoxStats": "updateHitboxStats",
    "getGlobalVariable": "sharedVar",
    "setGlobalVariable": "setSharedVar",
    "getGlobalVar": "gameVar",
    "setGlobalVar": "setGameVar",
    "createTimer": "addTimer",
    "destroyTimer": "removeTimer",
    "generateItem": "makePickup",
    "generateCharacterItem": "makeFighterPickup",
    "tossItem": "throwPickup",
    "spawnEnemy": "makeEnemy",
    "spawnItem": "placePickup",
    "replaceCharacter": "swapFighter",
    "rocketCharacter": "rocketFighter",
    "toHelpless": "goHelpless",
    "getCurrentAnimation": "getAnimation",
    "getCurrentAttackFrame": "getCurrentFrame",
    "setAttackEnabled": "allowAttack",
    "getAttackEnabled": "attackAllowed",
    "importCPUControls": "playCpuInputs",
    "resetCPUControls": "resetCpuInputs",
    "getCPUAction": "cpuAction",
    "getCPUForcedAction": "cpuForcedAction",
    "getCPULevel": "cpuLevel",
    "getCPUTarget": "cpuTarget",
    "setCPUAttackQueue": "setCpuQueue",
    "createSelfPlatform": "makeOwnFloor",
    "removeSelfPlatform": "dropOwnFloor",
    "calculateKnockback": "knockbackOf",
    "calculateKnockbackVelocity": "knockbackVelocityOf",
    "safeRandom": "randomUnit",
    "safeRandomInteger": "randomBetween",
    "getPaletteSwapData": "paletteData",
    "setPaletteSwapData": "setPaletteData",
    "inLowerLeftWarningBounds": "nearBottomLeft",
    "inLowerRightWarningBounds": "nearBottomRight",
    "inUpperLeftWarningBounds": "nearTopLeft",
    "inUpperRightWarningBounds": "nearTopRight",
    "getCurrentKirbyPower": "copyPower",
    "getKirbyHatMC": "copyHatClip",
    "activateFinalForm": "toFinalForm",
    "getFinalSmashCutscene": "finalCutscene",
    "triggerFSCutscene": "startFinalCutscene",
    "killFSCutscene": "endFinalCutscene",
    "setFinalSmashMeterCharge": "setFinalMeter",
    "isUsingFinalSmash": "inFinalSmash",
    "forceGrabbedHurtFrame": "grabbedHurtFrame",
    "gotoGrabbedCharacter": "toGrabbed",
    "shootOutOpponent": "ejectOpponent",
    "swapDepthsWithGrabbedOpponent": "swapDepthGrabbed",
    "throbDamageCounter": "throbDamage",
    "getMCByLinkageName": "clipByLinkage",
    "getHUDBackgroundMC": "hudBack",
    "getHUDForegroundMC": "hudFront",
    "getTetherCount": "tetherCount",
    "setIASA": "setInterruptible",
    "safeMove": "moveIfClear",
    "unnattachFromGround": "unattachFromFloor",
    "attachToGround": "attachToFloor",
    "getOwnStats": "ownStats",
    "setupAutolinkAngle": "startAutolink",
    "stopAutolinkAngle": "stopAutolink",
    "updateAutolinkTarget": "setAutolinkPoint",
    "updateAutolinkFunction": "setAutolinkRule"
  }
}

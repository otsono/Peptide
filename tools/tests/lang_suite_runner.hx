// runs the language suite's cases (AS3_SUITE, generated by `peptide ssf2 compile --lang-suite`)
// and answers "all N pass", or each case that did not give what AS3 gives
function __langSuite() {
	var bad = [];
	for (t in AS3_SUITE) {
		var got = null;
		try { got = AS3.str(t.run()); } catch (e:Dynamic) { got = "threw " + Std.string(e); }
		if (got != t.want) bad.push(t.name + ": got " + got + ", want " + t.want);
	}
	return bad.length == 0 ? "all " + AS3_SUITE.length + " pass" : bad.length + " fail: " + bad.join(" | ");
}
